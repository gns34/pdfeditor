---
---

<section id="comparison" class="py-24 bg-white border-b border-[#e3e8ee]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="micro-cap text-[#533afd] mb-3 block">Superior por Arquitetura</span>
      <h2 class="display-xl text-[#0d253d] mb-4">
        Por que o PDF Editor AI supera os editores tradicionais na nuvem.
      </h2>
      <p class="body-lg text-[#64748d]">
        Sem limites arbitrários por hora, sem carregamento forçado para a nuvem e sem subscrições escondidas para tarefas essenciais de edição.
      </p>
    </div>

    <!-- Comparison Table Card -->
    <div class="bg-white rounded-2xl border border-[#e3e8ee] shadow-level-2 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-[#f6f9fc] border-b border-[#e3e8ee]">
              <th class="py-4 px-6 text-[13px] font-semibold text-[#0d253d] w-1/3">Funcionalidade / Capacidade</th>
              <th class="py-4 px-6 text-[13px] font-bold text-[#533afd] bg-[#b9b9f9]/20 w-1/3 border-x border-[#533afd]/20">
                <div class="flex items-center gap-2">
                  <span>PDF Editor AI</span>
                  <span class="px-2 py-0.5 rounded-full text-[10px] bg-[#533afd] text-white">O nosso</span>
                </div>
              </th>
              <th class="py-4 px-6 text-[13px] font-medium text-[#64748d] w-1/6">iLovePDF</th>
              <th class="py-4 px-6 text-[13px] font-medium text-[#64748d] w-1/6">Sejda PDF</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#e3e8ee] text-[13px]">
            <!-- Row 1: Privacy -->
            <tr class="hover:bg-[#f6f9fc]/50 transition-colors">
              <td class="py-4 px-6 font-medium text-[#0d253d]">
                Privacidade e Armazenamento
                <span class="block text-[11px] text-[#64748d] font-normal">Onde são processados os seus documentos?</span>
              </td>
              <td class="py-4 px-6 font-medium text-emerald-600 bg-[#b9b9f9]/10 border-x border-[#533afd]/20">
                <div class="flex items-center gap-1.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>100% RAM Local (0 Envios para Servidores)</span>
                </div>
              </td>
              <td class="py-4 px-6 text-[#64748d]">Enviado para servidores na nuvem</td>
              <td class="py-4 px-6 text-[#64748d]">Enviado para servidores na nuvem</td>
            </tr>

            <!-- Row 2: Limits -->
            <tr class="hover:bg-[#f6f9fc]/50 transition-colors">
              <td class="py-4 px-6 font-medium text-[#0d253d]">
                Limites de Utilização Gratuita
                <span class="block text-[11px] text-[#64748d] font-normal">Restrições de tarefas por hora ou por dia</span>
              </td>
              <td class="py-4 px-6 font-medium text-emerald-600 bg-[#b9b9f9]/10 border-x border-[#533afd]/20">
                <div class="flex items-center gap-1.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>Ilimitado (Sem quotas nem bloqueios)</span>
                </div>
              </td>
              <td class="py-4 px-6 text-[#64748d]">Com limites e restrições de velocidade</td>
              <td class="py-4 px-6 text-[#ea2261] font-medium">Limite estrito de 3 tarefas por hora</td>
            </tr>

            <!-- Row 3: AI Redactor -->
            <tr class="hover:bg-[#f6f9fc]/50 transition-colors">
              <td class="py-4 px-6 font-medium text-[#0d253d]">
                Ocultação Automática de PII com IA
                <span class="block text-[11px] text-[#64748d] font-normal">Deteção de NIF, Cartão de Cidadão, IBAN e e-mails</span>
              </td>
              <td class="py-4 px-6 font-medium text-emerald-600 bg-[#b9b9f9]/10 border-x border-[#533afd]/20">
                <div class="flex items-center gap-1.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>1 Clique para Ocultar no Navegador</span>
                </div>
              </td>
              <td class="py-4 px-6 text-[#64748d]">Apenas manual</td>
              <td class="py-4 px-6 text-[#64748d]">Apenas manual</td>
            </tr>

            <!-- Row 4: File Size -->
            <tr class="hover:bg-[#f6f9fc]/50 transition-colors">
              <td class="py-4 px-6 font-medium text-[#0d253d]">
                Limite no Tamanho do Ficheiro
                <span class="block text-[11px] text-[#64748d] font-normal">Tamanho máximo para utilizadores gratuitos</span>
              </td>
              <td class="py-4 px-6 font-medium text-[#0d253d] bg-[#b9b9f9]/10 border-x border-[#533afd]/20 tabular-num">
                Sem limite artificial (limitado pela RAM)
              </td>
              <td class="py-4 px-6 text-[#64748d] tabular-num">Tamanho limitado</td>
              <td class="py-4 px-6 text-[#64748d] tabular-num">Máx. 50 MB</td>
            </tr>

            <!-- Row 5: Speed -->
            <tr class="hover:bg-[#f6f9fc]/50 transition-colors">
              <td class="py-4 px-6 font-medium text-[#0d253d]">
                Velocidade de Processamento
                <span class="block text-[11px] text-[#64748d] font-normal">Tempo total para editar e descarregar</span>
              </td>
              <td class="py-4 px-6 font-medium text-emerald-600 bg-[#b9b9f9]/10 border-x border-[#533afd]/20">
                <div class="flex items-center gap-1.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>Instantâneo e Local (&lt; 10 ms)</span>
                </div>
              </td>
              <td class="py-4 px-6 text-[#64748d]">Lento (Envio + Fila + Descarga)</td>
              <td class="py-4 px-6 text-[#64748d]">Lento (Envio + Fila + Descarga)</td>
            </tr>

            <!-- Row 6: E-Signatures -->
            <tr class="hover:bg-[#f6f9fc]/50 transition-colors">
              <td class="py-4 px-6 font-medium text-[#0d253d]">
                Assinatura Eletrónica Digital
                <span class="block text-[11px] text-[#64748d] font-normal">Desenho livre, caligrafia digital ou carimbos</span>
              </td>
              <td class="py-4 px-6 font-medium text-emerald-600 bg-[#b9b9f9]/10 border-x border-[#533afd]/20">
                <div class="flex items-center gap-1.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>Incluída Gratuitamente (Todos os modos)</span>
                </div>
              </td>
              <td class="py-4 px-6 text-[#64748d]">Bloqueada no iLoveSign pago</td>
              <td class="py-4 px-6 text-[#64748d]">Apenas desenho básico</td>
            </tr>

            <!-- Row 7: Pricing -->
            <tr class="hover:bg-[#f6f9fc]/50 transition-colors">
              <td class="py-4 px-6 font-medium text-[#0d253d]">
                Custo de Utilização
                <span class="block text-[11px] text-[#64748d] font-normal">Preço para edição completa de PDFs</span>
              </td>
              <td class="py-4 px-6 font-bold text-[#533afd] bg-[#b9b9f9]/10 border-x border-[#533afd]/20">
                100% Gratuito Para Sempre (Local)
              </td>
              <td class="py-4 px-6 text-[#64748d] tabular-num">7,00 € / mês</td>
              <td class="py-4 px-6 text-[#64748d] tabular-num">7,50 € / mês</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Table Footer CTA -->
      <div class="p-6 bg-[#f6f9fc] border-t border-[#e3e8ee] flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="text-[13px] text-[#64748d]">
          Pronto para experimentar edição de PDF privada e instantânea no seu navegador em Portugal?
        </div>
        <a href="/edit" class="btn-primary-pill text-[14px] py-2 px-6 shadow-sm">
          <span>Começar a Editar Agora — Grátis</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>

  </div>
</section>

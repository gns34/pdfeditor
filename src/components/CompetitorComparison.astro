---
---

<section id="comparison" class="py-24 bg-white border-b border-[#e3e8ee]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="micro-cap text-[#533afd] mb-3 block">Better by Architecture</span>
      <h2 class="display-xl text-[#0d253d] mb-4">
        Why PDF Editor AI outperforms traditional cloud editors.
      </h2>
      <p class="body-lg text-[#64748d]">
        No arbitrary hourly quotas, no mandatory cloud uploads, and no hidden subscriptions for basic editing tasks.
      </p>
    </div>

    <!-- Comparison Table Card -->
    <div class="bg-white rounded-2xl border border-[#e3e8ee] shadow-level-2 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-[#f6f9fc] border-b border-[#e3e8ee]">
              <th class="py-4 px-6 text-[13px] font-semibold text-[#0d253d] w-1/3">Feature / Capability</th>
              <th class="py-4 px-6 text-[13px] font-bold text-[#533afd] bg-[#b9b9f9]/20 w-1/3 border-x border-[#533afd]/20">
                <div class="flex items-center gap-2">
                  <span>PDF Editor AI</span>
                  <span class="px-2 py-0.5 rounded-full text-[10px] bg-[#533afd] text-white">Ours</span>
                </div>
              </th>
              <th class="py-4 px-6 text-[13px] font-medium text-[#64748d] w-1/6">iLovePDF</th>
              <th class="py-4 px-6 text-[13px] font-medium text-[#64748d] w-1/6">Sejda PDF</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#e3e8ee] text-[13px]">
            <!-- Row 1: Privacy -->
            <tr class="hover:bg-[#f6f9fc]/50 transition-colors">
              <td class="py-4 px-6 font-medium text-[#0d253d]">
                File Privacy & Storage
                <span class="block text-[11px] text-[#64748d] font-normal">Where are your documents processed?</span>
              </td>
              <td class="py-4 px-6 font-medium text-emerald-600 bg-[#b9b9f9]/10 border-x border-[#533afd]/20">
                <div class="flex items-center gap-1.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>100% Local RAM (0 Cloud Uploads)</span>
                </div>
              </td>
              <td class="py-4 px-6 text-[#64748d]">Uploaded to cloud servers</td>
              <td class="py-4 px-6 text-[#64748d]">Uploaded to cloud servers</td>
            </tr>

            <!-- Row 2: Limits -->
            <tr class="hover:bg-[#f6f9fc]/50 transition-colors">
              <td class="py-4 px-6 font-medium text-[#0d253d]">
                Free Usage Limits
                <span class="block text-[11px] text-[#64748d] font-normal">Tasks per hour or day restrictions</span>
              </td>
              <td class="py-4 px-6 font-medium text-emerald-600 bg-[#b9b9f9]/10 border-x border-[#533afd]/20">
                <div class="flex items-center gap-1.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>Unlimited (No task quotas)</span>
                </div>
              </td>
              <td class="py-4 px-6 text-[#64748d]">Rate-limited & throttled</td>
              <td class="py-4 px-6 text-[#ea2261] font-medium">Strict 3 tasks / hour limit</td>
            </tr>

            <!-- Row 3: AI Redactor -->
            <tr class="hover:bg-[#f6f9fc]/50 transition-colors">
              <td class="py-4 px-6 font-medium text-[#0d253d]">
                AI Smart PII Auto-Redact
                <span class="block text-[11px] text-[#64748d] font-normal">Auto-detect & blackout SSNs, cards, emails</span>
              </td>
              <td class="py-4 px-6 font-medium text-emerald-600 bg-[#b9b9f9]/10 border-x border-[#533afd]/20">
                <div class="flex items-center gap-1.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>1-Click In-Browser Auto-Redact</span>
                </div>
              </td>
              <td class="py-4 px-6 text-[#64748d]">Manual only</td>
              <td class="py-4 px-6 text-[#64748d]">Manual only</td>
            </tr>

            <!-- Row 4: File Size -->
            <tr class="hover:bg-[#f6f9fc]/50 transition-colors">
              <td class="py-4 px-6 font-medium text-[#0d253d]">
                File Size Limit
                <span class="block text-[11px] text-[#64748d] font-normal">Maximum document size for free users</span>
              </td>
              <td class="py-4 px-6 font-medium text-[#0d253d] bg-[#b9b9f9]/10 border-x border-[#533afd]/20 tabular-num">
                No arbitrary limit (RAM-bound)
              </td>
              <td class="py-4 px-6 text-[#64748d] tabular-num">Limited file size</td>
              <td class="py-4 px-6 text-[#64748d] tabular-num">50 MB max</td>
            </tr>

            <!-- Row 5: Speed -->
            <tr class="hover:bg-[#f6f9fc]/50 transition-colors">
              <td class="py-4 px-6 font-medium text-[#0d253d]">
                Processing Speed
                <span class="block text-[11px] text-[#64748d] font-normal">Roundtrip time to edit & save</span>
              </td>
              <td class="py-4 px-6 font-medium text-emerald-600 bg-[#b9b9f9]/10 border-x border-[#533afd]/20">
                <div class="flex items-center gap-1.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>Instant Local (&lt; 10ms)</span>
                </div>
              </td>
              <td class="py-4 px-6 text-[#64748d]">Slow (Upload + Queue + Download)</td>
              <td class="py-4 px-6 text-[#64748d]">Slow (Upload + Queue + Download)</td>
            </tr>

            <!-- Row 6: E-Signatures -->
            <tr class="hover:bg-[#f6f9fc]/50 transition-colors">
              <td class="py-4 px-6 font-medium text-[#0d253d]">
                E-Signature Studio
                <span class="block text-[11px] text-[#64748d] font-normal">Draw, type cursive, or upload stamps</span>
              </td>
              <td class="py-4 px-6 font-medium text-emerald-600 bg-[#b9b9f9]/10 border-x border-[#533afd]/20">
                <div class="flex items-center gap-1.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>Included Free (All Modes)</span>
                </div>
              </td>
              <td class="py-4 px-6 text-[#64748d]">Paywalled in iLoveSign</td>
              <td class="py-4 px-6 text-[#64748d]">Basic drawing</td>
            </tr>

            <!-- Row 7: Pricing -->
            <tr class="hover:bg-[#f6f9fc]/50 transition-colors">
              <td class="py-4 px-6 font-medium text-[#0d253d]">
                Core Pricing
                <span class="block text-[11px] text-[#64748d] font-normal">Cost for standard PDF editing</span>
              </td>
              <td class="py-4 px-6 font-bold text-[#533afd] bg-[#b9b9f9]/10 border-x border-[#533afd]/20">
                100% Free Forever Local
              </td>
              <td class="py-4 px-6 text-[#64748d] tabular-num">$7.00 / month</td>
              <td class="py-4 px-6 text-[#64748d] tabular-num">$7.50 / month</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Table Footer CTA -->
      <div class="p-6 bg-[#f6f9fc] border-t border-[#e3e8ee] flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="text-[13px] text-[#64748d]">
          Ready to experience private, instant in-browser editing?
        </div>
        <a href="/edit" class="btn-primary-pill text-[14px] py-2 px-6 shadow-sm">
          <span>Start Editing Now — Free</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>

  </div>
</section>

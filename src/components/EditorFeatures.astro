---
---

<section id="features" class="py-24 bg-[#f6f9fc] border-b border-[#e3e8ee]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Opener -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="micro-cap text-[#533afd] mb-3 block">Full In-Browser Studio</span>
      <h2 class="display-xl text-[#0d253d] mb-4">
        Every tool you need to modify, protect, and sign documents.
      </h2>
      <p class="body-lg text-[#64748d]">
        Engineered with pure client-side PDF.js and WebAssembly. No clunky desktop installations, no file size throttles, and no data tracking.
      </p>
    </div>

    <!-- 6 Feature Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      
      <!-- 1. Text Editing -->
      <div class="bg-white p-8 rounded-2xl border border-[#e3e8ee] shadow-level-1 hover:shadow-level-2 transition-all group">
        <div class="w-12 h-12 rounded-xl bg-[#533afd]/10 text-[#533afd] flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="4 7 4 4 20 4 20 7"/>
            <line x1="9" y1="20" x2="15" y2="20"/>
            <line x1="12" y1="4" x2="12" y2="20"/>
          </svg>
        </div>
        <h3 class="display-md text-[#0d253d] mb-3 text-[22px]">Direct Text Overlays</h3>
        <p class="body-md text-[#64748d] leading-relaxed mb-4">
          Add custom text blocks anywhere on your PDF. Pick fonts (Helvetica, Times, Courier), adjust font sizes from 10–48px, choose colors, and drag with precision.
        </p>
        <span class="text-[13px] text-[#533afd] font-medium flex items-center gap-1">
          <span>Double-click to edit anytime</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </span>
      </div>

      <!-- 2. Pen & Highlighter -->
      <div class="bg-white p-8 rounded-2xl border border-[#e3e8ee] shadow-level-1 hover:shadow-level-2 transition-all group">
        <div class="w-12 h-12 rounded-xl bg-[#f96bee]/10 text-[#ea2261] flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 19l7-7 3 3-7 7-3-3z"/>
            <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/>
            <path d="M2 2l7.586 7.586"/>
          </svg>
        </div>
        <h3 class="display-md text-[#0d253d] mb-3 text-[22px]">Freehand Pen & Highlighter</h3>
        <p class="body-md text-[#64748d] leading-relaxed mb-4">
          Draw freehand annotations, circle numbers, underline critical phrases, or use the translucent highlighter mode with automatic opacity blending.
        </p>
        <span class="text-[13px] text-[#533afd] font-medium flex items-center gap-1">
          <span>Smooth pen physics</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </span>
      </div>

      <!-- 3. Smart PII Auto-Redact -->
      <div id="ai-redactor" class="bg-white p-8 rounded-2xl border border-[#e3e8ee] shadow-level-1 hover:shadow-level-2 transition-all group relative overflow-hidden">
        <div class="absolute top-4 right-4">
          <span class="px-2 py-0.5 rounded-full text-[10px] font-medium bg-[#ea2261]/10 text-[#ea2261] uppercase tracking-wider">AI Powered</span>
        </div>
        <div class="w-12 h-12 rounded-xl bg-[#ea2261]/10 text-[#ea2261] flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
        </div>
        <h3 class="display-md text-[#0d253d] mb-3 text-[22px]">1-Click PII Auto-Redact</h3>
        <p class="body-md text-[#64748d] leading-relaxed mb-4">
          Instantly scan and sanitize documents. Automatically black out sensitive personal data like SSNs, credit card numbers, emails, and phone numbers.
        </p>
        <span class="text-[13px] text-[#533afd] font-medium flex items-center gap-1">
          <span>Zero cloud data leaks</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </span>
      </div>

      <!-- 4. Digital E-Signatures -->
      <div class="bg-white p-8 rounded-2xl border border-[#e3e8ee] shadow-level-1 hover:shadow-level-2 transition-all group">
        <div class="w-12 h-12 rounded-xl bg-[#533afd]/10 text-[#533afd] flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m18 2 4 4-12 12H6v-4L18 2z"/>
            <path d="m14 6 4 4"/>
            <path d="M4 22h16"/>
          </svg>
        </div>
        <h3 class="display-md text-[#0d253d] mb-3 text-[22px]">Digital E-Signatures</h3>
        <p class="body-md text-[#64748d] leading-relaxed mb-4">
          Create legally valid signatures in seconds: draw freehand on canvas, generate realistic cursive handwriting styles, or upload your signature image.
        </p>
        <span class="text-[13px] text-[#533afd] font-medium flex items-center gap-1">
          <span>Vector crisp export</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </span>
      </div>

      <!-- 5. Shapes & Whiteout -->
      <div class="bg-white p-8 rounded-2xl border border-[#e3e8ee] shadow-level-1 hover:shadow-level-2 transition-all group">
        <div class="w-12 h-12 rounded-xl bg-[#ded7fc] text-[#4434d4] flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="18" x="3" y="3" rx="2"/>
            <circle cx="9" cy="9" r="2"/>
          </svg>
        </div>
        <h3 class="display-md text-[#0d253d] mb-3 text-[22px]">Shapes, Stamps & Whiteout</h3>
        <p class="body-md text-[#64748d] leading-relaxed mb-4">
          Insert vector rectangles, circles, lines, and callout arrows. Place company logos, official stamps ("APPROVED", "CONFIDENTIAL"), or whiteout outdated text.
        </p>
        <span class="text-[13px] text-[#533afd] font-medium flex items-center gap-1">
          <span>Custom opacity & fills</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </span>
      </div>

      <!-- 6. Visual Page Organizer -->
      <div class="bg-white p-8 rounded-2xl border border-[#e3e8ee] shadow-level-1 hover:shadow-level-2 transition-all group">
        <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="7" height="9" x="3" y="3" rx="1"/>
            <rect width="7" height="5" x="14" y="3" rx="1"/>
            <rect width="7" height="9" x="14" y="12" rx="1"/>
            <rect width="7" height="5" x="3" y="16" rx="1"/>
          </svg>
        </div>
        <h3 class="display-md text-[#0d253d] mb-3 text-[22px]">Visual Page Manager</h3>
        <p class="body-md text-[#64748d] leading-relaxed mb-4">
          Rotate individual pages 90° clockwise, reorder pages with drag-and-drop thumbnail previews, duplicate key pages, or delete unnecessary pages.
        </p>
        <span class="text-[13px] text-[#533afd] font-medium flex items-center gap-1">
          <span>Instant thumbnail re-indexing</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </span>
      </div>

    </div>

  </div>
</section>

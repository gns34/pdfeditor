<!-- Interactive Client Script (Fabric.js + PDF.js + pdf-lib) -->
<script>
  import { PdfEngine, type ExtractedTextItem } from '../scripts/pdf-engine';
  import { PdfAiAssistant } from '../scripts/pdf-ai';
  import confetti from 'canvas-confetti';
  import { PDFDocument, rgb, StandardFonts } from 'pdf-lib';
  import {
    Canvas,
    IText,
    Textbox,
    Rect,
    Ellipse,
    Line,
    Triangle,
    Group,
    FabricImage,
    PencilBrush,
    FabricObject,
  } from 'fabric';

  const engine = new PdfEngine();
  let fabricCanvas: Canvas | null = null;

  // State
  let currentPageIndex = 0;
  let currentTool: string = 'select'; // 'select' | 'text' | 'edit-existing' | 'draw' | 'highlight' | 'shape' | 'whiteout'
  let activeColor = '#0d253d';
  let activeFontSize = 16;
  let activeFontFamily: string = 'Helvetica';
  let activeShapeType: 'rectangle' | 'circle' | 'arrow' | 'line' = 'rectangle';
  let activeStrokeWidth = 2.5;
  let currentScale = 1.3;
  let extractedItems: ExtractedTextItem[] = [];

  // Shape interactive drawing state
  let isShapeDrawing = false;
  let shapeStartX = 0;
  let shapeStartY = 0;
  let activeShapeObj: FabricObject | null = null;

  // DOM Elements
  const container = document.getElementById('pdf-studio-container');
  const dropzoneView = document.getElementById('editor-dropzone-view');
  const viewportContainer = document.getElementById('editor-viewport-container');
  const pdfCanvas = document.getElementById('pdf-render-canvas') as HTMLCanvasElement;
  const extractedTextLayer = document.getElementById('extracted-text-layer');
  const thumbnailList = document.getElementById('pages-thumbnail-list');
  const totalPageCount = document.getElementById('total-page-count');
  const downloadBtn = document.getElementById('download-pdf-btn') as HTMLButtonElement;
  const toast = document.getElementById('editor-toast');
  const toastMsg = document.getElementById('toast-message');
  const zoomDisplay = document.getElementById('zoom-display');

  // Tool buttons
  const toolBtns = document.querySelectorAll('.tool-btn');
  const shapesMenuBtn = document.getElementById('shapes-menu-btn');
  const shapesDropdown = document.getElementById('shapes-dropdown');
  const shapeTypeBtns = document.querySelectorAll('.shape-type-btn');

  // Properties
  const colorInput = document.getElementById('active-color-input') as HTMLInputElement;
  const colorPreview = document.getElementById('color-preview-circle');
  const sizeSelect = document.getElementById('active-size-select') as HTMLSelectElement;
  const fontSelect = document.getElementById('active-font-select') as HTMLSelectElement;

  // AI Sidebar
  const aiSidebar = document.getElementById('editor-ai-sidebar');
  const toggleAiBtn = document.getElementById('toggle-ai-sidebar-btn');
  const closeAiBtn = document.getElementById('close-ai-sidebar-btn');
  const aiAutoRedactBtn = document.getElementById('ai-auto-redact-btn');
  const customRedactKw = document.getElementById('custom-redact-keyword') as HTMLInputElement;
  const aiRedactMsg = document.getElementById('ai-redact-result-msg');
  const generateSummaryBtn = document.getElementById('generate-summary-btn');
  const summaryArea = document.getElementById('summary-content-area');
  const askDocBtn = document.getElementById('ask-doc-btn');
  const askDocInput = document.getElementById('ask-doc-input') as HTMLInputElement;
  const askDocAnswer = document.getElementById('ask-doc-answer');

  // Signature Modal
  const signModal = document.getElementById('signature-modal');
  const openSignModalBtn = document.getElementById('open-sign-modal-btn');
  const closeSignModalBtn = document.getElementById('close-signature-modal');
  const cancelSignBtn = document.getElementById('cancel-signature-btn');
  const applySignBtn = document.getElementById('apply-signature-btn');
  const sigCanvas = document.getElementById('signature-canvas') as HTMLCanvasElement;
  const clearSigBtn = document.getElementById('clear-signature-btn');
  const tabDrawBtn = document.getElementById('tab-draw-btn');
  const tabTypeBtn = document.getElementById('tab-type-btn');
  const tabUploadBtn = document.getElementById('tab-upload-btn');
  const tabDrawContent = document.getElementById('tab-draw-content');
  const tabTypeContent = document.getElementById('tab-type-content');
  const tabUploadContent = document.getElementById('tab-upload-content');
  const typedSigInput = document.getElementById('typed-signature-input') as HTMLInputElement;
  const sigFontOptions = document.querySelectorAll('.sig-font-option');
  const sigFileInput = document.getElementById('signature-file-input') as HTMLInputElement;
  const uploadSigPreview = document.getElementById('upload-signature-preview') as HTMLImageElement;
  const imageUploadInput = document.getElementById('image-upload-input') as HTMLInputElement;

  function showToast(message: string) {
    if (!toast || !toastMsg) return;
    toastMsg.textContent = message;
    toast.classList.remove('translate-y-20', 'opacity-0');
    toast.classList.add('translate-y-0', 'opacity-100');
    setTimeout(() => {
      toast.classList.remove('translate-y-0', 'opacity-100');
      toast.classList.add('translate-y-20', 'opacity-0');
    }, 2500);
  }

  // Initialize Fabric.js interactive canvas overlay
  function initFabricCanvas() {
    if (fabricCanvas) {
      fabricCanvas.dispose();
    }
    
    fabricCanvas = new Canvas('fabric-canvas', {
      selection: true,
      preserveObjectStacking: true,
    });

    fabricCanvas.on('object:modified', () => {
      engine.recordHistory();
    });

    fabricCanvas.on('path:created', () => {
      engine.recordHistory();
    });

    fabricCanvas.on('mouse:dblclick', (opt: any) => {
      if (opt.target && (opt.target instanceof Textbox || opt.target instanceof IText)) {
        opt.target.enterEditing();
        fabricCanvas?.renderAll();
      }
    });

    fabricCanvas.on('selection:created', (e: any) => {
      const selected = e.selected?.[0];
      if (selected && (selected instanceof IText || selected instanceof Textbox)) {
        if (selected.fill && typeof selected.fill === 'string' && selected.fill.startsWith('#')) {
          activeColor = selected.fill;
          if (colorInput) colorInput.value = activeColor;
          if (colorPreview) colorPreview.style.backgroundColor = activeColor;
        }
      }
    });

    fabricCanvas.on('selection:updated', (e: any) => {
      const selected = e.selected?.[0];
      if (selected && (selected instanceof IText || selected instanceof Textbox)) {
        if (selected.fill && typeof selected.fill === 'string' && selected.fill.startsWith('#')) {
          activeColor = selected.fill;
          if (colorInput) colorInput.value = activeColor;
          if (colorPreview) colorPreview.style.backgroundColor = activeColor;
        }
      }
    });

    // Interactive mouse events for text placement and shape drawing
    fabricCanvas.on('mouse:down', (opt: any) => {
      if (!fabricCanvas) return;
      const pt = opt.scenePoint || opt.pointer;
      if (!pt) return;

      if (currentTool === 'text') {
        if (opt.target && opt.target instanceof IText) return;
        const fontName = activeFontFamily === 'TimesRoman' ? 'serif' : activeFontFamily === 'Courier' ? 'monospace' : 'sans-serif';
        const itext = new IText('Type your text...', {
          left: pt.x,
          top: pt.y,
          fontSize: activeFontSize,
          fontFamily: fontName,
          fill: activeColor,
          editable: true,
        });
        fabricCanvas.add(itext);
        fabricCanvas.setActiveObject(itext);
        itext.enterEditing();
        itext.selectAll();
        fabricCanvas.renderAll();
        engine.recordHistory();
        setTool('select');
      } else if (currentTool === 'shape' || currentTool === 'whiteout') {
        isShapeDrawing = true;
        shapeStartX = pt.x;
        shapeStartY = pt.y;

        if (currentTool === 'whiteout') {
          activeShapeObj = new Rect({
            left: shapeStartX,
            top: shapeStartY,
            width: 1,
            height: 1,
            fill: '#ffffff',
            stroke: '#e3e8ee',
            strokeWidth: 1,
            rx: 2,
            ry: 2,
          });
          fabricCanvas.add(activeShapeObj);
        } else if (currentTool === 'shape') {
          if (activeShapeType === 'rectangle') {
            activeShapeObj = new Rect({
              left: shapeStartX,
              top: shapeStartY,
              width: 1,
              height: 1,
              fill: 'transparent',
              stroke: activeColor,
              strokeWidth: activeStrokeWidth,
              rx: 4,
              ry: 4,
            });
          } else if (activeShapeType === 'circle') {
            activeShapeObj = new Ellipse({
              left: shapeStartX,
              top: shapeStartY,
              rx: 1,
              ry: 1,
              fill: 'transparent',
              stroke: activeColor,
              strokeWidth: activeStrokeWidth,
            });
          } else if (activeShapeType === 'line' || activeShapeType === 'arrow') {
            activeShapeObj = new Line([shapeStartX, shapeStartY, shapeStartX, shapeStartY], {
              stroke: activeColor,
              strokeWidth: activeStrokeWidth,
            });
          }
          if (activeShapeObj) {
            fabricCanvas.add(activeShapeObj);
          }
        }
      }
    });

    fabricCanvas.on('mouse:move', (opt: any) => {
      if (!isShapeDrawing || !activeShapeObj || !fabricCanvas) return;
      const pt = opt.scenePoint || opt.pointer;
      if (!pt) return;

      const curX = pt.x;
      const curY = pt.y;

      if (activeShapeObj instanceof Rect) {
        activeShapeObj.set({
          left: Math.min(shapeStartX, curX),
          top: Math.min(shapeStartY, curY),
          width: Math.abs(curX - shapeStartX),
          height: Math.abs(curY - shapeStartY),
        });
      } else if (activeShapeObj instanceof Ellipse) {
        const rx = Math.abs(curX - shapeStartX) / 2;
        const ry = Math.abs(curY - shapeStartY) / 2;
        activeShapeObj.set({
          left: Math.min(shapeStartX, curX),
          top: Math.min(shapeStartY, curY),
          rx,
          ry,
        });
      } else if (activeShapeObj instanceof Line) {
        activeShapeObj.set({
          x2: curX,
          y2: curY,
        });
      }
      fabricCanvas.renderAll();
    });

    fabricCanvas.on('mouse:up', () => {
      if (isShapeDrawing) {
        isShapeDrawing = false;
        if (activeShapeObj && fabricCanvas) {
          if (currentTool === 'shape' && activeShapeType === 'arrow' && activeShapeObj instanceof Line) {
            const x1 = activeShapeObj.x1 ?? shapeStartX;
            const y1 = activeShapeObj.y1 ?? shapeStartY;
            const x2 = activeShapeObj.x2 ?? shapeStartX;
            const y2 = activeShapeObj.y2 ?? shapeStartY;
            const angle = Math.atan2(y2 - y1, x2 - x1) * (180 / Math.PI);
            const headLen = 14;
            const triangle = new Triangle({
              left: x2,
              top: y2,
              angle: angle + 90,
              width: headLen,
              height: headLen,
              fill: activeColor,
              originX: 'center',
              originY: 'center',
            });
            fabricCanvas.remove(activeShapeObj);
            const arrowGroup = new Group([activeShapeObj, triangle]);
            fabricCanvas.add(arrowGroup);
            fabricCanvas.setActiveObject(arrowGroup);
          } else {
            fabricCanvas.setActiveObject(activeShapeObj);
          }
          fabricCanvas.renderAll();
          engine.recordHistory();
          activeShapeObj = null;
        }
      }
    });
  }

  // Load PDF file into Engine
  async function loadPdfBuffer(buffer: ArrayBuffer) {
    try {
      showToast('Processing PDF locally in RAM with PDF.js...');
      const visiblePages = await engine.loadPdf(buffer);
      if (visiblePages.length === 0) return;

      currentPageIndex = 0;
      if (totalPageCount) totalPageCount.textContent = String(visiblePages.length);
      if (downloadBtn) downloadBtn.disabled = false;

      dropzoneView?.classList.add('hidden');
      viewportContainer?.classList.remove('hidden');

      initFabricCanvas();
      await renderCurrentPage();
      await renderThumbnails(visiblePages);
      showToast('PDF loaded with Fabric.js vector canvas!');
    } catch (err) {
      console.error(err);
      alert('Could not render PDF. Please verify file format.');
    }
  }

  async function renderCurrentPage() {
    if (!pdfCanvas) return;
    
    // 1. Render PDF page with PDF.js
    const dims = await engine.renderPageToCanvas(currentPageIndex, pdfCanvas, currentScale);
    
    // 2. Attach Fabric.js canvas
    if (!fabricCanvas) {
      initFabricCanvas();
    }
    if (fabricCanvas) {
      await engine.attachFabricCanvas(fabricCanvas, currentPageIndex, dims.width, dims.height, currentScale);
      setTool(currentTool);
    }

    // 3. Extract text items for direct in-place text editing & AI
    extractedItems = await engine.getPageTextItems(currentPageIndex);
    renderExtractedTextBadges();
  }

  // Tool Switching and Configuration
  function setTool(tool: string) {
    currentTool = tool;
    toolBtns.forEach(b => {
      if (b.getAttribute('data-tool') === tool) {
        b.classList.add('active', 'border-[#533afd]', 'bg-[#b9b9f9]/20', 'text-[#533afd]');
      } else {
        b.classList.remove('active', 'border-[#533afd]', 'bg-[#b9b9f9]/20', 'text-[#533afd]');
      }
    });

    if (!fabricCanvas) return;

    if (tool === 'select' || tool === 'edit-existing') {
      fabricCanvas.isDrawingMode = false;
      fabricCanvas.selection = true;
      fabricCanvas.defaultCursor = 'default';
      renderExtractedTextBadges();
      extractedTextLayer?.classList.remove('hidden');
    } else if (tool === 'text') {
      fabricCanvas.isDrawingMode = false;
      fabricCanvas.selection = false;
      fabricCanvas.defaultCursor = 'text';
      extractedTextLayer?.classList.add('hidden');
    } else if (tool === 'draw') {
      fabricCanvas.isDrawingMode = true;
      fabricCanvas.selection = false;
      const brush = new PencilBrush(fabricCanvas);
      brush.color = activeColor;
      brush.width = activeStrokeWidth;
      fabricCanvas.freeDrawingBrush = brush;
      extractedTextLayer?.classList.add('hidden');
    } else if (tool === 'highlight') {
      fabricCanvas.isDrawingMode = true;
      fabricCanvas.selection = false;
      const brush = new PencilBrush(fabricCanvas);
      brush.color = 'rgba(253, 224, 71, 0.45)';
      brush.width = 24;
      fabricCanvas.freeDrawingBrush = brush;
      extractedTextLayer?.classList.add('hidden');
    } else if (tool === 'shape' || tool === 'whiteout') {
      fabricCanvas.isDrawingMode = false;
      fabricCanvas.selection = false;
      fabricCanvas.defaultCursor = 'crosshair';
      extractedTextLayer?.classList.add('hidden');
    }
  }

  // Render clickable text overlay for instant in-place direct editing
  function renderExtractedTextBadges() {
    if (!extractedTextLayer) return;
    extractedTextLayer.innerHTML = '';

    if (currentTool !== 'select' && currentTool !== 'edit-existing') {
      return;
    }

    const isEditGuideMode = currentTool === 'edit-existing';

    for (const item of extractedItems) {
      const badge = document.createElement('div');
      
      // Styling: In 'select' mode, transparent with subtle hover outline; in 'edit-existing' mode, visible dashed guides
      if (isEditGuideMode) {
        badge.className = 'absolute pointer-events-auto rounded border border-dashed border-[#533afd]/60 bg-[#533afd]/10 hover:bg-[#533afd]/25 hover:border-[#533afd] cursor-pointer transition-colors';
      } else {
        badge.className = 'absolute pointer-events-auto rounded border border-transparent hover:border-[#533afd]/50 hover:bg-[#533afd]/10 cursor-text transition-all';
      }

      const boxLeft = item.x * currentScale;
      const boxTop = item.y * currentScale;
      const boxWidth = item.width * currentScale;
      const boxHeight = item.height * currentScale;

      badge.style.left = `${boxLeft}px`;
      badge.style.top = `${boxTop}px`;
      badge.style.width = `${boxWidth}px`;
      badge.style.height = `${boxHeight}px`;
      badge.title = `Click to edit: "${item.str}"`;

      badge.addEventListener('click', (e) => {
        e.stopPropagation();
        if (!fabricCanvas) return;

        // Hide badge so it does not intercept user clicks while editing
        badge.style.display = 'none';

        // 1. Create a clean solid whiteout mask covering the original PDF raster text cleanly
        const maskRect = new Rect({
          left: Math.max(0, boxLeft - 2),
          top: Math.max(0, boxTop - 2),
          width: boxWidth + 5,
          height: Math.max(boxHeight + 4, item.fontSize * currentScale * 1.25),
          fill: '#ffffff',
          stroke: 'transparent',
          strokeWidth: 0,
          selectable: false,
          evented: false,
          hoverCursor: 'default',
        });

        // 2. Create the in-place editable Textbox directly over the whited-out region
        const fontName = item.fontFamily === 'TimesRoman' ? 'serif' : item.fontFamily === 'Courier' ? 'monospace' : 'sans-serif';
        const editBox = new Textbox(item.str, {
          left: boxLeft,
          top: boxTop,
          width: Math.max(boxWidth + 8, 60),
          fontSize: item.fontSize * currentScale,
          fontFamily: fontName,
          fontWeight: item.isBold ? 'bold' : 'normal',
          fill: activeColor || '#0d253d',
          backgroundColor: 'transparent',
          padding: 2,
          editable: true,
          cursorColor: '#533afd',
          borderColor: '#533afd',
          cornerColor: '#533afd',
          cornerSize: 7,
          cornerStyle: 'circle',
        });

        (editBox as any)._maskRect = maskRect;

        // Add mask underneath, then text box
        fabricCanvas.add(maskRect);
        fabricCanvas.add(editBox);
        fabricCanvas.setActiveObject(editBox);

        editBox.enterEditing();
        editBox.selectAll();
        fabricCanvas.renderAll();
        engine.recordHistory();

        editBox.on('editing:exited', () => {
          engine.recordHistory();
          fabricCanvas?.renderAll();
        });

        setTool('select');
        showToast('Text block ready to edit in-place');
      });

      extractedTextLayer.appendChild(badge);
    }
  }

  // Insert image or signature onto Fabric canvas
  async function insertImageOnCanvas(dataUrl: string, defaultWidth: number = 180) {
    if (!fabricCanvas) return;
    try {
      const img = await FabricImage.fromURL(dataUrl);
      const scale = defaultWidth / (img.width || 1);
      img.set({
        left: 100,
        top: 150,
        scaleX: scale,
        scaleY: scale,
      });
      fabricCanvas.add(img);
      fabricCanvas.setActiveObject(img);
      fabricCanvas.renderAll();
      engine.recordHistory();
      setTool('select');
      showToast('Image inserted on page');
    } catch (err) {
      console.error('Failed to insert image onto canvas', err);
    }
  }

  // Render Page Thumbnails in Left Sidebar
  async function renderThumbnails(pages: any[]) {
    if (!thumbnailList) return;
    thumbnailList.innerHTML = '';

    for (const p of pages) {
      const thumbItem = document.createElement('div');
      thumbItem.className = `p-2 rounded-xl border transition-all cursor-pointer ${p.pageIndex === currentPageIndex ? 'border-[#533afd] bg-[#b9b9f9]/10 shadow-xs ring-1 ring-[#533afd]' : 'border-[#e3e8ee] hover:border-[#a8c3de] bg-white'}`;
      thumbItem.dataset.pageIndex = String(p.pageIndex);

      const thumbUrl = await engine.generateThumbnail(p.pageIndex);
      thumbItem.innerHTML = `
        <div class="relative rounded overflow-hidden bg-gray-50 aspect-3/4 border border-[#e3e8ee] mb-1.5">
          <img src="${thumbUrl}" class="w-full h-full object-contain pointer-events-none" />
          <span class="absolute bottom-1 right-1 bg-[#0d253d]/70 text-white text-[10px] px-1.5 py-0.5 rounded font-mono">${p.pageIndex + 1}</span>
        </div>
        <div class="flex items-center justify-between text-[11px] text-[#64748d]">
          <span>Page ${p.pageIndex + 1}</span>
          <button class="delete-page-btn text-[#64748d] hover:text-[#ea2261] p-0.5" title="Delete page">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
          </button>
        </div>
      `;

      thumbItem.addEventListener('click', async (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('.delete-page-btn')) {
          e.stopPropagation();
          if (confirm(`Delete Page ${p.pageIndex + 1}?`)) {
            engine.deletePage(p.pageIndex);
            const remaining = engine.getVisiblePages();
            if (remaining.length > 0) {
              currentPageIndex = remaining[0].pageIndex;
              await renderCurrentPage();
              await renderThumbnails(remaining);
            }
          }
          return;
        }
        currentPageIndex = p.pageIndex;
        await renderCurrentPage();
        document.querySelectorAll('#pages-thumbnail-list > div').forEach(el => {
          el.classList.remove('border-[#533afd]', 'bg-[#b9b9f9]/10', 'ring-1', 'ring-[#533afd]');
          el.classList.add('border-[#e3e8ee]', 'bg-white');
        });
        thumbItem.classList.add('border-[#533afd]', 'bg-[#b9b9f9]/10', 'ring-1', 'ring-[#533afd]');
      });

      thumbnailList.appendChild(thumbItem);
    }
  }

  // Generate Sample PDF Agreement for immediate testing
  async function generateSamplePdf() {
    const doc = await PDFDocument.create();
    const font = await doc.embedFont(StandardFonts.Helvetica);
    const fontBold = await doc.embedFont(StandardFonts.HelveticaBold);

    // Page 1: Agreement
    const page1 = doc.addPage([595.28, 841.89]);
    page1.drawText('MUTUAL NON-DISCLOSURE AGREEMENT', {
      x: 50,
      y: 780,
      size: 18,
      font: fontBold,
      color: rgb(0.05, 0.15, 0.24),
    });

    page1.drawText('This Agreement is entered into by and between Acme Corp and Nova Global.', {
      x: 50,
      y: 740,
      size: 11,
      font: font,
      color: rgb(0.2, 0.25, 0.3),
    });

    page1.drawText('1. Confidential Information & Data Protection', {
      x: 50,
      y: 700,
      size: 13,
      font: fontBold,
      color: rgb(0.05, 0.15, 0.24),
    });

    page1.drawText('Contact Email: legal-confidential@acmecorp.com | Direct Phone: +1 (555) 492-9102', {
      x: 50,
      y: 675,
      size: 11,
      font: font,
      color: rgb(0.2, 0.25, 0.3),
    });

    page1.drawText('Billing Reference: 4532-8921-9844-1234 | Tax ID / SSN: 123-45-6789', {
      x: 50,
      y: 650,
      size: 11,
      font: font,
      color: rgb(0.2, 0.25, 0.3),
    });

    page1.drawText('The receiving party agrees that all proprietary technical diagrams, source code, and customer records', {
      x: 50,
      y: 615,
      size: 11,
      font: font,
      color: rgb(0.2, 0.25, 0.3),
    });
    page1.drawText('shall be protected with strict encryption. Neither party shall disclose terms without written consent.', {
      x: 50,
      y: 595,
      size: 11,
      font: font,
      color: rgb(0.2, 0.25, 0.3),
    });

    page1.drawText('2. Signatures & Approvals', {
      x: 50,
      y: 540,
      size: 13,
      font: fontBold,
      color: rgb(0.05, 0.15, 0.24),
    });

    page1.drawRectangle({
      x: 50,
      y: 430,
      width: 230,
      height: 70,
      borderColor: rgb(0.8, 0.85, 0.9),
      borderWidth: 1,
    });
    page1.drawText('Authorized Signature (Party A):', { x: 60, y: 485, size: 10, font: font, color: rgb(0.4, 0.45, 0.5) });

    page1.drawRectangle({
      x: 310,
      y: 430,
      width: 230,
      height: 70,
      borderColor: rgb(0.8, 0.85, 0.9),
      borderWidth: 1,
    });
    page1.drawText('Authorized Signature (Party B):', { x: 320, y: 485, size: 10, font: font, color: rgb(0.4, 0.45, 0.5) });

    // Page 2: Schedule
    const page2 = doc.addPage([595.28, 841.89]);
    page2.drawText('SCHEDULE A — DELIVERABLES & PAYMENT MILESTONES', {
      x: 50,
      y: 780,
      size: 16,
      font: fontBold,
      color: rgb(0.05, 0.15, 0.24),
    });
    page2.drawText('Total Agreed Consideration: $45,000.00 USD payable upon completion.', {
      x: 50,
      y: 740,
      size: 11,
      font: font,
      color: rgb(0.2, 0.25, 0.3),
    });
    page2.drawText('Effective Date: October 1, 2026. Governing Law: State of Delaware.', {
      x: 50,
      y: 715,
      size: 11,
      font: font,
      color: rgb(0.2, 0.25, 0.3),
    });

    return await doc.save();
  }

  // File Upload Handlers
  const fileInput = document.getElementById('pdf-file-input') as HTMLInputElement;
  fileInput?.addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) {
      const buffer = await file.arrayBuffer();
      await loadPdfBuffer(buffer);
    }
  });

  const samplePdfBtn = document.getElementById('load-sample-pdf-btn');
  samplePdfBtn?.addEventListener('click', async () => {
    const sampleBytes = await generateSamplePdf();
    await loadPdfBuffer(sampleBytes.buffer as ArrayBuffer);
  });

  // Tool Switching
  toolBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const tool = btn.getAttribute('data-tool');
      if (tool) {
        setTool(tool);
      }
    });
  });

  // Shapes dropdown
  shapesMenuBtn?.addEventListener('click', () => {
    shapesDropdown?.classList.toggle('hidden');
  });

  shapeTypeBtns.forEach(b => {
    b.addEventListener('click', () => {
      const st = b.getAttribute('data-shape') as any;
      if (st) {
        activeShapeType = st;
        shapesDropdown?.classList.add('hidden');
        setTool('shape');
        showToast(`Shape tool: ${st}`);
      }
    });
  });

  // Color, Size, Font Controls
  colorInput?.addEventListener('input', (e) => {
    activeColor = (e.target as HTMLInputElement).value;
    if (colorPreview) colorPreview.style.backgroundColor = activeColor;
    
    if (fabricCanvas) {
      const activeObj = fabricCanvas.getActiveObject();
      if (activeObj) {
        if (activeObj instanceof IText || activeObj instanceof Textbox) {
          activeObj.set('fill', activeColor);
        } else if (activeObj instanceof Rect || activeObj instanceof Ellipse || activeObj instanceof Line) {
          activeObj.set('stroke', activeColor);
        }
        fabricCanvas.renderAll();
        engine.recordHistory();
      }
      if (fabricCanvas.isDrawingMode && fabricCanvas.freeDrawingBrush) {
        fabricCanvas.freeDrawingBrush.color = activeColor;
      }
    }
  });

  sizeSelect?.addEventListener('change', (e) => {
    activeFontSize = parseInt((e.target as HTMLSelectElement).value, 10);
    if (fabricCanvas) {
      const activeObj = fabricCanvas.getActiveObject();
      if (activeObj && (activeObj instanceof IText || activeObj instanceof Textbox)) {
        activeObj.set('fontSize', activeFontSize * currentScale);
        fabricCanvas.renderAll();
        engine.recordHistory();
      }
    }
  });

  fontSelect?.addEventListener('change', (e) => {
    activeFontFamily = (e.target as HTMLSelectElement).value;
    const fontName = activeFontFamily === 'TimesRoman' ? 'serif' : activeFontFamily === 'Courier' ? 'monospace' : 'sans-serif';
    if (fabricCanvas) {
      const activeObj = fabricCanvas.getActiveObject();
      if (activeObj && (activeObj instanceof IText || activeObj instanceof Textbox)) {
        activeObj.set('fontFamily', fontName);
        fabricCanvas.renderAll();
        engine.recordHistory();
      }
    }
  });

  // Undo / Redo
  document.getElementById('undo-btn')?.addEventListener('click', async () => {
    if (await engine.undo()) {
      showToast('Undo');
    }
  });

  document.getElementById('redo-btn')?.addEventListener('click', async () => {
    if (await engine.redo()) {
      showToast('Redo');
    }
  });

  // Keyboard Shortcuts (Ctrl+Z, Ctrl+Y, Delete, V, T, P, H, E)
  window.addEventListener('keydown', async (e) => {
    if ((e.target as HTMLElement).tagName === 'TEXTAREA' || (e.target as HTMLElement).tagName === 'INPUT') return;
    
    if ((e.ctrlKey || e.metaKey) && e.key === 'z') {
      e.preventDefault();
      if (await engine.undo()) {
        showToast('Undo');
      }
    } else if ((e.ctrlKey || e.metaKey) && e.key === 'y') {
      e.preventDefault();
      if (await engine.redo()) {
        showToast('Redo');
      }
    } else if (e.key === 'Delete' || e.key === 'Backspace') {
      if (fabricCanvas) {
        const activeObjs = fabricCanvas.getActiveObjects();
        if (activeObjs.length > 0) {
          activeObjs.forEach(obj => fabricCanvas?.remove(obj));
          fabricCanvas.discardActiveObject();
          fabricCanvas.renderAll();
          engine.recordHistory();
          showToast('Deleted object');
        }
      }
    } else if (e.key === 'v' || e.key === 'V') {
      setTool('select');
    } else if (e.key === 't' || e.key === 'T') {
      setTool('text');
    } else if (e.key === 'p' || e.key === 'P') {
      setTool('draw');
    } else if (e.key === 'h' || e.key === 'H') {
      setTool('highlight');
    } else if (e.key === 'e' || e.key === 'E') {
      setTool('edit-existing');
    }
  });

  // Zoom Controls
  document.getElementById('zoom-in-btn')?.addEventListener('click', async () => {
    currentScale = Math.min(currentScale + 0.25, 2.5);
    if (zoomDisplay) zoomDisplay.textContent = `${Math.round(currentScale * 100)}%`;
    await renderCurrentPage();
  });

  document.getElementById('zoom-out-btn')?.addEventListener('click', async () => {
    currentScale = Math.max(currentScale - 0.25, 0.5);
    if (zoomDisplay) zoomDisplay.textContent = `${Math.round(currentScale * 100)}%`;
    await renderCurrentPage();
  });

  // Rotate Page 90°
  document.getElementById('rotate-current-page-btn')?.addEventListener('click', async () => {
    engine.rotatePage(currentPageIndex, 90);
    await renderCurrentPage();
    const visible = engine.getVisiblePages();
    await renderThumbnails(visible);
    showToast('Page rotated 90°');
  });

  // Export & Download PDF via pdf-lib
  downloadBtn?.addEventListener('click', async () => {
    try {
      showToast('Rendering high-DPI layers with pdf-lib...');
      const outputBytes = await engine.exportPdf();
      const blob = new Blob([outputBytes], { type: 'application/pdf' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `edited-document-${Date.now()}.pdf`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);

      confetti({
        particleCount: 90,
        spread: 70,
        origin: { y: 0.8 },
        colors: ['#533afd', '#ea2261', '#f96bee', '#4434d4']
      });

      showToast('PDF exported successfully!');
    } catch (e) {
      console.error(e);
      alert('Failed to export PDF: ' + e);
    }
  });

  // AI Assistant Drawer
  toggleAiBtn?.addEventListener('click', () => aiSidebar?.classList.toggle('hidden'));
  closeAiBtn?.addEventListener('click', () => aiSidebar?.classList.add('hidden'));

  // 1-Click PII Auto-Redact into Fabric.js Rectangles
  aiAutoRedactBtn?.addEventListener('click', async () => {
    if (!fabricCanvas) return;
    try {
      showToast('Scanning page for sensitive PII...');
      const textItems = await engine.getPageTextItems(currentPageIndex);
      const customWords = customRedactKw?.value ? [customRedactKw.value] : [];
      const matches = PdfAiAssistant.detectPii(currentPageIndex, textItems, customWords);

      if (matches.length === 0) {
        if (aiRedactMsg) {
          aiRedactMsg.textContent = 'No sensitive emails, SSNs, or cards found on this page.';
          aiRedactMsg.classList.remove('hidden');
        }
        showToast('No PII detected');
        return;
      }

      for (const m of matches) {
        const redactRect = new Rect({
          left: m.x * currentScale,
          top: m.y * currentScale,
          width: m.width * currentScale,
          height: m.height * currentScale,
          fill: '#0d253d',
          stroke: '#0d253d',
          strokeWidth: 1,
        });
        fabricCanvas.add(redactRect);
      }
      fabricCanvas.renderAll();
      engine.recordHistory();

      if (aiRedactMsg) {
        aiRedactMsg.textContent = `Auto-redacted ${matches.length} items (${matches.map(m => m.label).join(', ')}).`;
        aiRedactMsg.classList.remove('hidden');
      }
      showToast(`Redacted ${matches.length} sensitive items!`);
    } catch (err) {
      console.error(err);
    }
  });

  // AI Document Summarizer
  generateSummaryBtn?.addEventListener('click', async () => {
    if (!summaryArea) return;
    summaryArea.innerHTML = '<span class="animate-pulse text-[#533afd]">Analyzing document text...</span>';
    const pagesText = await engine.extractFullText();
    const summary = PdfAiAssistant.summarizeDocument(pagesText);

    summaryArea.innerHTML = `
      <div class="flex gap-2 text-[11px] text-[#273951] font-mono pb-1 border-b border-[#e3e8ee]">
        <span>Pages: <strong>${summary.pageCount}</strong></span>
        <span>Words: <strong>${summary.wordCount}</strong></span>
        <span>Reading: <strong>~${summary.readingTimeMinutes} min</strong></span>
      </div>
      <p class="font-medium text-[#0d253d] text-[12px] pt-1">Executive Summary:</p>
      <p class="leading-relaxed text-[#64748d]">${summary.executiveSummary}</p>
      <p class="font-medium text-[#0d253d] text-[12px] pt-1">Key Takeaways:</p>
      <ul class="list-disc pl-4 space-y-1 text-[#64748d]">
        ${summary.keyTakeaways.map(t => `<li>${t}</li>`).join('')}
      </ul>
    `;
  });

  // AI Q&A Search
  askDocBtn?.addEventListener('click', async () => {
    const q = askDocInput?.value;
    if (!q || !askDocAnswer) return;
    askDocAnswer.classList.remove('hidden');
    askDocAnswer.innerHTML = '<span class="animate-pulse text-[#533afd]">Searching clauses...</span>';

    const pagesText = await engine.extractFullText();
    const res = PdfAiAssistant.askQuestion(pagesText, q);
    askDocAnswer.innerHTML = `
      <p class="font-medium text-[#0d253d] mb-1">Answer:</p>
      <p class="text-[#273951] leading-relaxed">${res.answer}</p>
    `;
  });

  // Signature Modal Logic
  let sigDrawing = false;
  let activeSigTypeStyle = 'dancing';
  let activeSigColor = '#0d253d';

  openSignModalBtn?.addEventListener('click', () => signModal?.classList.remove('hidden'));
  closeSignModalBtn?.addEventListener('click', () => signModal?.classList.add('hidden'));
  cancelSignBtn?.addEventListener('click', () => signModal?.classList.add('hidden'));

  tabDrawBtn?.addEventListener('click', () => {
    tabDrawBtn.classList.add('border-[#533afd]', 'text-[#533afd]');
    tabTypeBtn?.classList.remove('border-[#533afd]', 'text-[#533afd]');
    tabUploadBtn?.classList.remove('border-[#533afd]', 'text-[#533afd]');
    tabDrawContent?.classList.remove('hidden');
    tabTypeContent?.classList.add('hidden');
    tabUploadContent?.classList.add('hidden');
  });

  tabTypeBtn?.addEventListener('click', () => {
    tabTypeBtn.classList.add('border-[#533afd]', 'text-[#533afd]');
    tabDrawBtn?.classList.remove('border-[#533afd]', 'text-[#533afd]');
    tabUploadBtn?.classList.remove('border-[#533afd]', 'text-[#533afd]');
    tabTypeContent?.classList.remove('hidden');
    tabDrawContent?.classList.add('hidden');
    tabUploadContent?.classList.add('hidden');
  });

  tabUploadBtn?.addEventListener('click', () => {
    tabUploadBtn.classList.add('border-[#533afd]', 'text-[#533afd]');
    tabDrawBtn?.classList.remove('border-[#533afd]', 'text-[#533afd]');
    tabTypeBtn?.classList.remove('border-[#533afd]', 'text-[#533afd]');
    tabUploadContent?.classList.remove('hidden');
    tabDrawContent?.classList.add('hidden');
    tabTypeContent?.classList.add('hidden');
  });

  // Draw signature pad
  const sigCtx = sigCanvas?.getContext('2d');
  if (sigCtx) {
    sigCtx.lineWidth = 2.5;
    sigCtx.lineCap = 'round';
    sigCtx.strokeStyle = '#0d253d';
  }

  const sigColorBtns = document.querySelectorAll('.sig-color-btn');
  sigColorBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const col = btn.getAttribute('data-color');
      if (col && sigCtx) {
        activeSigColor = col;
        sigCtx.strokeStyle = col;
        sigColorBtns.forEach(b => b.classList.remove('ring-2', 'ring-offset-1', 'ring-[#533afd]'));
        btn.classList.add('ring-2', 'ring-offset-1', 'ring-[#533afd]');
      }
    });
  });

  sigCanvas?.addEventListener('mousedown', (e) => {
    sigDrawing = true;
    const rect = sigCanvas.getBoundingClientRect();
    sigCtx?.beginPath();
    sigCtx?.moveTo(e.clientX - rect.left, e.clientY - rect.top);
  });
  sigCanvas?.addEventListener('mousemove', (e) => {
    if (!sigDrawing) return;
    const rect = sigCanvas.getBoundingClientRect();
    sigCtx?.lineTo(e.clientX - rect.left, e.clientY - rect.top);
    sigCtx?.stroke();
  });
  sigCanvas?.addEventListener('mouseup', () => { sigDrawing = false; });

  // Touch event support for signature pad
  sigCanvas?.addEventListener('touchstart', (e) => {
    e.preventDefault();
    sigDrawing = true;
    const rect = sigCanvas.getBoundingClientRect();
    const touch = e.touches[0];
    sigCtx?.beginPath();
    sigCtx?.moveTo(touch.clientX - rect.left, touch.clientY - rect.top);
  }, { passive: false });
  sigCanvas?.addEventListener('touchmove', (e) => {
    e.preventDefault();
    if (!sigDrawing) return;
    const rect = sigCanvas.getBoundingClientRect();
    const touch = e.touches[0];
    sigCtx?.lineTo(touch.clientX - rect.left, touch.clientY - rect.top);
    sigCtx?.stroke();
  }, { passive: false });
  sigCanvas?.addEventListener('touchend', () => { sigDrawing = false; });

  clearSigBtn?.addEventListener('click', () => {
    sigCtx?.clearRect(0, 0, sigCanvas.width, sigCanvas.height);
  });

  typedSigInput?.addEventListener('input', (e) => {
    const val = (e.target as HTMLInputElement).value || 'Alex Morgan';
    document.querySelectorAll('.preview-sig-text').forEach(el => {
      el.textContent = val;
    });
  });

  sigFontOptions.forEach(opt => {
    opt.addEventListener('click', () => {
      sigFontOptions.forEach(o => o.classList.remove('border-[#533afd]', 'bg-[#b9b9f9]/10'));
      opt.classList.add('border-[#533afd]', 'bg-[#b9b9f9]/10');
      activeSigTypeStyle = opt.getAttribute('data-font') as any;
    });
  });

  // Signature file upload
  sigFileInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = () => {
        if (uploadSigPreview) {
          uploadSigPreview.src = reader.result as string;
          document.getElementById('upload-preview-container')?.classList.remove('hidden');
        }
      };
      reader.readAsDataURL(file);
    }
  });

  // Insert signature onto document
  applySignBtn?.addEventListener('click', async () => {
    let sigDataUrl = '';
    if (!tabDrawContent?.classList.contains('hidden')) {
      sigDataUrl = sigCanvas.toDataURL('image/png');
    } else if (!tabTypeContent?.classList.contains('hidden')) {
      const name = typedSigInput.value || 'Alex Morgan';
      sigDataUrl = PdfAiAssistant.generateCursiveSignature(name, activeSigTypeStyle as any, activeSigColor);
    } else if (!tabUploadContent?.classList.contains('hidden')) {
      sigDataUrl = uploadSigPreview.src;
    }

    if (sigDataUrl) {
      await insertImageOnCanvas(sigDataUrl, 160);
      signModal?.classList.add('hidden');
    }
  });

  // Image stamp upload
  imageUploadInput?.addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = async () => {
        const dataUrl = reader.result as string;
        await insertImageOnCanvas(dataUrl, 180);
      };
      reader.readAsDataURL(file);
    }
  });
</script>


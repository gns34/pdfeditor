---
import SignatureModal from './SignatureModal.astro';

interface Props {
  mode?: 'standalone' | 'embedded';
}

const { mode = 'standalone' } = Astro.props;
---

<div class={`pdf-studio-root w-full flex flex-col ${mode === 'standalone' ? 'h-[calc(100vh-64px)]' : 'h-[800px] rounded-2xl border border-[#e3e8ee] shadow-level-2 overflow-hidden'}`} id="pdf-studio-container">
  
  <!-- Studio Top Toolbar -->
  <div class="bg-white border-b border-[#e3e8ee] px-4 py-2.5 flex flex-wrap items-center justify-between gap-3 select-none z-20">
    <!-- Left: Tool Groups -->
    <div class="flex items-center gap-1 sm:gap-1.5 flex-wrap">
      
      <!-- Select / Move Tool -->
      <button class="tool-btn active p-2 rounded-lg text-[#273951] hover:bg-[#f6f9fc] hover:text-[#533afd] transition-colors border border-transparent flex items-center gap-1" data-tool="select" title="Select, Move, Scale & Rotate Objects (V)">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m3 3 7 18 3-7 7-3L3 3z"/>
          <path d="m13 13 6 6"/>
        </svg>
        <span class="text-[12px] hidden lg:inline">Select</span>
      </button>

      <!-- Edit Existing Text Mode -->
      <button class="tool-btn p-2 rounded-lg text-[#273951] hover:bg-[#f6f9fc] hover:text-[#533afd] transition-colors border border-transparent flex items-center gap-1" data-tool="edit-existing" title="Click & In-Place Edit Existing PDF Text (E)">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-[#533afd]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 20h9"/>
          <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/>
        </svg>
        <span class="text-[12px] font-medium hidden lg:inline text-[#533afd]">Edit Text</span>
      </button>

      <!-- Add New Text Tool -->
      <button class="tool-btn p-2 rounded-lg text-[#273951] hover:bg-[#f6f9fc] hover:text-[#533afd] transition-colors border border-transparent flex items-center gap-1" data-tool="text" title="Click to Add New Text Box (T)">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="4 7 4 4 20 4 20 7"/>
          <line x1="9" y1="20" x2="15" y2="20"/>
          <line x1="12" y1="4" x2="12" y2="20"/>
        </svg>
        <span class="text-[12px] hidden lg:inline">Add Text</span>
      </button>

      <!-- Freehand Pen -->
      <button class="tool-btn p-2 rounded-lg text-[#273951] hover:bg-[#f6f9fc] hover:text-[#533afd] transition-colors border border-transparent flex items-center gap-1" data-tool="draw" title="Draw / Smooth Pen (P)">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 19l7-7 3 3-7 7-3-3z"/>
          <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/>
          <path d="M2 2l7.586 7.586"/>
        </svg>
        <span class="text-[12px] hidden xl:inline">Pen</span>
      </button>

      <!-- Highlighter -->
      <button class="tool-btn p-2 rounded-lg text-[#273951] hover:bg-[#f6f9fc] hover:text-[#533afd] transition-colors border border-transparent flex items-center gap-1" data-tool="highlight" title="Highlighter (H)">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m9 11-6 6v3h3l6-6"/>
          <path d="m22 2-5 5-4-4 5-5a2.828 2.828 0 1 1 4 4z"/>
        </svg>
        <span class="text-[12px] hidden xl:inline">Highlight</span>
      </button>

      <!-- Shapes Dropdown -->
      <div class="relative inline-block">
        <button id="shapes-menu-btn" class="tool-btn p-2 rounded-lg text-[#273951] hover:bg-[#f6f9fc] hover:text-[#533afd] transition-colors border border-transparent flex items-center gap-1" data-tool="shape" title="Shapes (Rectangle, Circle, Arrow, Line)">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="18" x="3" y="3" rx="2"/>
          </svg>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-2.5 h-2.5 text-[#64748d]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <!-- Shapes Menu -->
        <div id="shapes-dropdown" class="hidden absolute left-0 top-full mt-1 bg-white border border-[#e3e8ee] rounded-xl shadow-level-2 p-1.5 z-30 flex flex-col gap-1 w-36">
          <button class="shape-type-btn flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-[13px] text-[#273951] hover:bg-[#f6f9fc] hover:text-[#533afd] text-left" data-shape="rectangle">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2"/></svg>
            <span>Rectangle</span>
          </button>
          <button class="shape-type-btn flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-[13px] text-[#273951] hover:bg-[#f6f9fc] hover:text-[#533afd] text-left" data-shape="circle">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>
            <span>Circle</span>
          </button>
          <button class="shape-type-btn flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-[13px] text-[#273951] hover:bg-[#f6f9fc] hover:text-[#533afd] text-left" data-shape="arrow">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            <span>Arrow</span>
          </button>
          <button class="shape-type-btn flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-[13px] text-[#273951] hover:bg-[#f6f9fc] hover:text-[#533afd] text-left" data-shape="line">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="19" x2="19" y2="5"/></svg>
            <span>Line</span>
          </button>
        </div>
      </div>

      <!-- Whiteout / Redact -->
      <button class="tool-btn p-2 rounded-lg text-[#273951] hover:bg-[#f6f9fc] hover:text-[#533afd] transition-colors border border-transparent flex items-center gap-1" data-tool="whiteout" title="Whiteout Mask / Redact Area">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m7 21-4.3-4.3c-1-1-1-2.5 0-3.4l9.6-9.6c1-1 2.5-1 3.4 0l5.6 5.6c1 1 1 2.5 0 3.4L13 21"/>
          <path d="M22 21H7"/>
          <path d="m5 11 9 9"/>
        </svg>
        <span class="text-[12px] hidden lg:inline">Whiteout</span>
      </button>

      <!-- Signature -->
      <button id="open-sign-modal-btn" class="tool-btn p-2 rounded-lg text-[#273951] hover:bg-[#f6f9fc] hover:text-[#533afd] transition-colors border border-transparent flex items-center gap-1.5" title="Insert E-Signature">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m18 2 4 4-12 12H6v-4L18 2z"/>
          <path d="m14 6 4 4"/>
          <path d="M4 22h16"/>
        </svg>
        <span class="text-[12px] font-normal hidden sm:inline">Sign</span>
      </button>

      <!-- Image / Stamp -->
      <label class="tool-btn p-2 rounded-lg text-[#273951] hover:bg-[#f6f9fc] hover:text-[#533afd] transition-colors border border-transparent cursor-pointer flex items-center gap-1" title="Insert Image / Stamp">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
          <circle cx="9" cy="9" r="2"/>
          <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
        </svg>
        <span class="text-[12px] hidden lg:inline">Image</span>
        <input type="file" id="image-upload-input" accept="image/png, image/jpeg, image/svg+xml, image/webp" class="hidden" />
      </label>

      <!-- AI Assistant Button -->
      <button id="toggle-ai-sidebar-btn" class="p-1.5 px-2.5 rounded-lg bg-[#b9b9f9]/30 text-[#4434d4] hover:bg-[#b9b9f9]/50 transition-colors flex items-center gap-1.5 border border-[#533afd]/20 text-[13px] font-medium" title="AI Document Assistant">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-[#533afd]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
        </svg>
        <span>AI Assistant</span>
      </button>
    </div>

    <!-- Center: Contextual Tool Properties -->
    <div id="tool-props-bar" class="flex items-center gap-2 text-[13px] text-[#273951] bg-[#f6f9fc] px-3 py-1 rounded-lg border border-[#e3e8ee]">
      <!-- Color Picker -->
      <div class="flex items-center gap-1">
        <label for="active-color-input" class="cursor-pointer flex items-center gap-1.5">
          <span id="color-preview-circle" class="w-4 h-4 rounded-full bg-[#0d253d] border border-[#e3e8ee]"></span>
          <span class="text-[12px] text-[#64748d]">Color</span>
        </label>
        <input type="color" id="active-color-input" value="#0d253d" class="w-0 h-0 opacity-0 absolute" />
      </div>

      <div class="w-px h-4 bg-[#e3e8ee]"></div>

      <!-- Size -->
      <div class="flex items-center gap-1.5">
        <span class="text-[12px] text-[#64748d]">Size:</span>
        <select id="active-size-select" class="bg-transparent border-0 text-[#0d253d] font-normal text-[13px] focus:outline-none cursor-pointer">
          <option value="12">12px</option>
          <option value="14">14px</option>
          <option value="16" selected>16px</option>
          <option value="18">18px</option>
          <option value="22">22px</option>
          <option value="28">28px</option>
          <option value="36">36px</option>
        </select>
      </div>

      <div class="w-px h-4 bg-[#e3e8ee]"></div>

      <!-- Font Family -->
      <select id="active-font-select" class="bg-transparent border-0 text-[#0d253d] font-normal text-[13px] focus:outline-none cursor-pointer">
        <option value="Helvetica">Helvetica / Modern</option>
        <option value="TimesRoman">Times / Serif</option>
        <option value="Courier">Courier / Mono</option>
      </select>
    </div>

    <!-- Right: Undo/Redo, Zoom & Single-Indigo Download CTA -->
    <div class="flex items-center gap-2">
      <!-- Undo / Redo -->
      <div class="flex items-center">
        <button id="undo-btn" class="p-1.5 text-[#64748d] hover:text-[#0d253d] hover:bg-[#f6f9fc] rounded transition-colors" title="Undo (Ctrl+Z)">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 7v6h6"/>
            <path d="M21 17a9 9 0 0 0-9-9 9 9 0 0 0-6 2.3L3 13"/>
          </svg>
        </button>
        <button id="redo-btn" class="p-1.5 text-[#64748d] hover:text-[#0d253d] hover:bg-[#f6f9fc] rounded transition-colors" title="Redo (Ctrl+Y)">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 7v6h-6"/>
            <path d="M3 17a9 9 0 0 1 9-9 9 9 0 0 1 6 2.3l3 2.7"/>
          </svg>
        </button>
      </div>

      <div class="w-px h-5 bg-[#e3e8ee]"></div>

      <!-- Zoom Controls -->
      <div class="flex items-center gap-1 text-[13px] text-[#273951] bg-[#f6f9fc] px-2 py-1 rounded-lg border border-[#e3e8ee]">
        <button id="zoom-out-btn" class="p-0.5 text-[#64748d] hover:text-[#0d253d] font-bold text-sm px-1">-</button>
        <span id="zoom-display" class="tabular-num font-mono text-[12px] px-1 min-w-10 text-center">130%</span>
        <button id="zoom-in-btn" class="p-0.5 text-[#64748d] hover:text-[#0d253d] font-bold text-sm px-1">+</button>
      </div>

      <!-- Single Primary Indigo CTA -->
      <button id="download-pdf-btn" class="btn-primary-pill text-[13px] py-1.5 px-4 shadow-sm" disabled>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        <span>Download PDF</span>
      </button>
    </div>
  </div>

  <!-- Studio Workspace (Sidebar + Canvas Viewport + AI Assistant) -->
  <div class="flex-1 flex overflow-hidden relative bg-[#f6f9fc]">
    
    <!-- Left Sidebar: Pages & Thumbnails -->
    <aside id="editor-left-sidebar" class="w-64 bg-white border-r border-[#e3e8ee] flex flex-col z-10">
      <!-- Header -->
      <div class="p-3 border-b border-[#e3e8ee] flex items-center justify-between">
        <div class="flex items-center gap-1.5 text-[13px] font-medium text-[#0d253d]">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-[#533afd]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2"/></svg>
          <span>Pages (<span id="total-page-count" class="tabular-num">0</span>)</span>
        </div>
        <button id="rotate-current-page-btn" class="text-[#64748d] hover:text-[#533afd] p-1 rounded hover:bg-[#f6f9fc] transition-colors" title="Rotate Current Page 90° Clockwise">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
          </svg>
        </button>
      </div>

      <!-- Thumbnail List -->
      <div id="pages-thumbnail-list" class="flex-1 overflow-y-auto p-4 space-y-4">
        <div id="no-pages-placeholder" class="text-center py-12 text-[#64748d] text-[13px]">
          No document loaded
        </div>
      </div>

      <!-- Bottom Status -->
      <div class="p-3 border-t border-[#e3e8ee] bg-[#f6f9fc] flex items-center justify-between text-[12px] text-[#64748d]">
        <span class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>Zero Server Uploads</span>
        </span>
        <label for="pdf-file-input" class="text-[#533afd] hover:underline cursor-pointer">Open File</label>
      </div>
    </aside>

    <!-- Center Canvas Area -->
    <main id="editor-main-canvas-area" class="flex-1 overflow-auto p-6 flex flex-col items-center justify-start relative select-none">
      
      <!-- Dropzone State (When No Document is Loaded) -->
      <div id="editor-dropzone-view" class="w-full max-w-2xl my-auto bg-white rounded-3xl border-2 border-dashed border-[#a8c3de] p-10 text-center shadow-level-2 relative overflow-hidden transition-all hover:border-[#533afd]">
        <div class="w-16 h-16 rounded-2xl bg-[#b9b9f9]/20 text-[#533afd] flex items-center justify-center mx-auto mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
            <polyline points="14 2 14 8 20 8"/>
            <path d="M12 18v-6"/>
            <path d="m9 15 3-3 3 3"/>
          </svg>
        </div>

        <h3 class="display-md text-[#0d253d] mb-2">Drop your PDF here to edit</h3>
        <p class="body-md text-[#64748d] max-w-md mx-auto mb-6">
          Files are processed <strong class="text-[#0d253d] font-medium">100% locally in your browser memory</strong> using PDF.js & Fabric.js. No cloud servers, total privacy.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <label for="pdf-file-input" class="btn-primary-pill cursor-pointer shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="17 8 12 3 7 8"/>
              <line x1="12" y1="3" x2="12" y2="15"/>
            </svg>
            <span>Choose PDF File</span>
          </label>

          <button id="load-sample-pdf-btn" class="btn-secondary-pill">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-[#533afd]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="5 3 19 12 5 21 5 3"/>
            </svg>
            <span>Try Sample Contract PDF</span>
          </button>
        </div>

        <input type="file" id="pdf-file-input" accept="application/pdf" class="hidden" />

        <!-- Privacy Badges -->
        <div class="mt-8 pt-6 border-t border-[#e3e8ee] flex flex-wrap items-center justify-center gap-6 text-[12px] text-[#64748d]">
          <span class="flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            Zero Server Uploads
          </span>
          <span class="flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-[#533afd]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
            Fabric.js Vector Canvas
          </span>
          <span class="flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-purple-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
            AI PII Auto-Redaction
          </span>
        </div>
      </div>

      <!-- Active PDF Page Viewport (Shown when document loaded) -->
      <div id="editor-viewport-container" class="hidden relative pb-16">
        <!-- Page Wrapper with Level 2 Shadow -->
        <div id="active-page-wrapper" class="relative bg-white rounded-lg shadow-level-2 border border-[#e3e8ee] transition-all origin-top select-none">
          <!-- Background PDF Render Canvas (PDF.js) -->
          <canvas id="pdf-render-canvas" class="block rounded-lg pointer-events-none"></canvas>
          
          <!-- Interactive Fabric.js Canvas Layer directly overlaid -->
          <div id="fabric-canvas-wrapper" class="absolute inset-0 z-20">
            <canvas id="fabric-canvas"></canvas>
          </div>

          <!-- Extracted Text Layer for Clicking & Editing Existing Text -->
          <div id="extracted-text-layer" class="absolute inset-0 w-full h-full z-30 pointer-events-none hidden"></div>
        </div>
      </div>

    </main>

    <!-- Right Sidebar: AI Assistant Drawer -->
    <aside id="editor-ai-sidebar" class="w-80 bg-white border-l border-[#e3e8ee] flex flex-col z-20 shadow-level-1 hidden">
      <!-- AI Header -->
      <div class="p-4 border-b border-[#e3e8ee] flex items-center justify-between bg-[#f6f9fc]">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-lg bg-[#533afd] text-white flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
          </div>
          <h4 class="font-medium text-[15px] text-[#0d253d]">AI Document Superpowers</h4>
        </div>
        <button id="close-ai-sidebar-btn" class="text-[#64748d] hover:text-[#0d253d]">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>

      <!-- AI Content -->
      <div class="flex-1 overflow-y-auto p-4 space-y-6">
        

---
---

<section class="gradient-mesh-hero relative pt-16 pb-20 overflow-hidden border-b border-[#e3e8ee]/60">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
    
    <!-- Top Pill Tag -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#b9b9f9]/40 border border-[#533afd]/20 text-[#4434d4] text-[12px] font-medium mb-8 backdrop-blur-xs">
      <span class="w-2 h-2 rounded-full bg-[#533afd] animate-pulse"></span>
      <span class="tracking-wide">Motor WebAssembly 100% Privado no Navegador</span>
    </div>

    <!-- Display XXL Hero Headline -->
    <h1 class="display-xxl text-[#0d253d] max-w-4xl mx-auto mb-6 tracking-tight">
      Editor de PDF online gratuito com <span class="text-[#533afd] font-normal">privacidade total</span> e superpoderes de IA.
    </h1>

    <!-- Body Lead -->
    <p class="body-lg text-[#273951] max-w-2xl mx-auto mb-10 leading-relaxed font-light">
      Edite texto, desenhe anotações, aplique assinaturas eletrónicas e oculte automaticamente dados sensíveis como NIF, CC e IBAN — sem nunca carregar os seus ficheiros para servidores remotos.
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-14">
      <a href="/edit" class="btn-primary-pill text-[16px] py-3 px-8 shadow-level-1 group">
        <span>Abrir Editor no Navegador</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"/>
          <path d="m12 5 7 7-7 7"/>
        </svg>
      </a>
      
      <a href="#demo" class="btn-secondary-pill text-[15px] py-3 px-6">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-[#533afd]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="5 3 19 12 5 21 5 3"/>
        </svg>
        <span>Experimentar Demonstração</span>
      </a>
    </div>

    <!-- Metrics Strip (Tabular numbers) -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-3xl mx-auto pt-6 border-t border-[#e3e8ee]/70 text-left">
      <div class="p-3">
        <span class="block text-2xl font-light text-[#0d253d] tabular-num tracking-tight">0 B</span>
        <span class="text-[12px] text-[#64748d]">Sem envios para a nuvem • RAM local</span>
      </div>
      <div class="p-3">
        <span class="block text-2xl font-light text-[#533afd] tabular-num tracking-tight">Ilimitado</span>
        <span class="text-[12px] text-[#64748d]">Edição gratuita • Sem limites/hora</span>
      </div>
      <div class="p-3">
        <span class="block text-2xl font-light text-[#0d253d] tabular-num tracking-tight">&lt; 10 ms</span>
        <span class="text-[12px] text-[#64748d]">Renderização local instantânea</span>
      </div>
      <div class="p-3">
        <span class="block text-2xl font-light text-[#ea2261] tabular-num tracking-tight">100%</span>
        <span class="text-[12px] text-[#64748d]">Conforme RGPD • Privacidade auditada</span>
      </div>
    </div>

  </div>
</section>

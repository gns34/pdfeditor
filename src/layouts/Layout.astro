---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	canonical?: string;
	keywords?: string;
	ogImage?: string;
	ogType?: string;
	schemaJson?: Record<string, any> | Array<Record<string, any>>;
}

const defaultTitle = 'Editor de PDF Online Gratuito — Editar PDF Grátis sem Limites | PDF Editor AI';
const defaultDescription = 'Use o melhor editor de pdf online grátis para editar pdf diretamente no navegador. Ferramenta gratuita sem registo para editar texto, assinar, anotar e ocultar dados confidenciais com 100% de privacidade.';
const defaultKeywords = 'editar pdf, editor pdf, editor pdf online, editor pdf gratuito, editor pdf online grátis, editor pdf online gratuito, editor pdf online gratis, editor pdf gratis, editor de pdf, editor de pdf online, editor de pdf gratuito, editor de pdf grátis, editor de pdf online grátis, editor de pdf online gratuito, editor de pdf online gratis, editar pdf online, editar pdf gratuito, editar pdf online gratis, editar pdf grátis, editar pdf online gratuito, editar pdf gratis, editar pdf online grátis, editar pdf online free, editar pdf gratuito online';

const { 
	title = defaultTitle,
	description = defaultDescription,
	canonical,
	keywords = defaultKeywords,
	ogImage = 'https://pdfeditx.com/og-image.jpg',
	ogType = 'website',
	schemaJson
} = Astro.props;

// Canonical URL derivation
const siteUrl = 'https://pdfeditx.com';
const canonicalUrl = canonical || (Astro.url ? new URL(Astro.url.pathname, siteUrl).href.replace(/\/$/, '') || siteUrl : siteUrl);

// Base WebApplication Schema
const defaultAppSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebApplication',
	'name': 'PDF Editor AI',
	'alternateName': [
		'Editor de PDF Online',
		'Editor PDF Gratuito',
		'Editar PDF Online Grátis',
		'PDF Editor Online Free'
	],
	'url': siteUrl,
	'applicationCategory': 'UtilitiesApplication',
	'operatingSystem': 'All (Web Browser)',
	'browserRequirements': 'Requires JavaScript and HTML5 Canvas. Works on Chrome, Edge, Safari, Firefox, Opera.',
	'offers': {
		'@type': 'Offer',
		'price': '0',
		'priceCurrency': 'EUR',
		'availability': 'https://schema.org/InStock'
	},
	'image': ogImage,
	'description': defaultDescription,
	'featureList': [
		'Edição e inserção de caixas de texto com fontes personalizadas',
		'Caneta à mão livre e marcador de texto translúcido',
		'Assinatura digital e eletrónica manuscrita ou tipográfica',
		'Ocultação automática e censura de PII (NIF, CC, IBAN) com inteligência artificial local',
		'Desenho de formas vetoriais, corretor branco e carimbos oficiais',
		'Organização visual, rotação de 90° e eliminação de páginas',
		'Processamento 100% no cliente em WebAssembly com zero envio de ficheiros para servidores'
	]
};

const finalSchemas = schemaJson 
	? (Array.isArray(schemaJson) ? [defaultAppSchema, ...schemaJson] : [defaultAppSchema, schemaJson])
	: [defaultAppSchema];
---

<!doctype html>
<html lang="pt-PT" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="sitemap" href="/sitemap.xml" />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		<meta name="author" content="PDF Editor AI" />
		<meta name="theme-color" content="#533afd" />
		
		<!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="PDF Editor AI" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:secure_url" content={ogImage} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="PDF Editor AI — Editor de PDF Online Gratuito e 100% Privado" />
		<meta property="og:locale" content="pt_PT" />
		<meta property="og:locale:alternate" content="pt_BR" />

		<!-- Twitter Meta Tags -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalUrl} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content="PDF Editor AI — Editor de PDF Online Gratuito e 100% Privado" />

		<!-- JSON-LD Structured Data for Google Rich Snippets -->
		{finalSchemas.map((schema) => (
			<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
		))}

		<!-- Inter Font with 300, 400, 500, 600 weights & Cursive Fonts for E-Signatures -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@500;700&family=Inter:wght@300;400;500;600;700&family=Pacifico&display=swap" rel="stylesheet">

		<!-- Zero-FOUC Instant Theme Initialization -->
		<script is:inline>
			(function() {
				try {
					const savedTheme = localStorage.getItem('theme') || 'light';
					document.documentElement.setAttribute('data-theme', savedTheme);
					if (savedTheme === 'dark') document.documentElement.classList.add('dark');
					else if (savedTheme === 'black') document.documentElement.classList.add('black');
				} catch (e) {}
			})();
		</script>
	</head>
	<body class="min-h-screen bg-[var(--bg-page)] text-[var(--text-primary)] antialiased selection:bg-[#b9b9f9] selection:text-[#1c1e54] transition-colors duration-200">
		<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[#533afd] focus:text-white focus:rounded-full focus:shadow-level-2 focus:text-sm focus:outline-none focus:ring-2 focus:ring-[#533afd] focus:ring-offset-2">
			Saltar para o conteúdo principal
		</a>
		<slot />
	</body>
</html>

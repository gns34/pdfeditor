---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = 'PDF Editor AI — Editor de PDF Online Gratuito e 100% Privado no Navegador',
	description = 'Edite documentos PDF diretamente no seu navegador com 100% de privacidade em Portugal. Sem envio para a nuvem, edição gratuita ilimitada, ocultação inteligente de NIF e dados pessoais com IA, assinaturas eletrónicas e gestão de páginas.'
} = Astro.props;
---

<!doctype html>
<html lang="pt-PT" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" href="/sitemap.xml" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		
		<!-- Open Graph / Meta -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://pdfeditx.com" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:locale" content="pt_PT" />
		<meta name="twitter:card" content="summary_large_image" />

		<!-- Inter Font with 300, 400, 500, 600 weights & Cursive Fonts for E-Signatures -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@500;700&family=Inter:wght@300;400;500;600;700&family=Pacifico&display=swap" rel="stylesheet">

		<!-- Zero-FOUC Instant Theme Initialization -->
		<script is:inline>
			(function() {
				try {
					const savedTheme = localStorage.getItem('theme') || 'light';
					document.documentElement.setAttribute('data-theme', savedTheme);
					if (savedTheme === 'dark') document.documentElement.classList.add('dark');
					else if (savedTheme === 'black') document.documentElement.classList.add('black');
				} catch (e) {}
			})();
		</script>
	</head>
	<body class="min-h-screen bg-[var(--bg-page)] text-[var(--text-primary)] antialiased selection:bg-[#b9b9f9] selection:text-[#1c1e54] transition-colors duration-200">
		<slot />
	</body>
</html>

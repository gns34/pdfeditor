---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import PdfEditorStudio from '../components/PdfEditorStudio.astro';
import EditorFeatures from '../components/EditorFeatures.astro';
import PrivacyGuarantee from '../components/PrivacyGuarantee.astro';
import CompetitorComparison from '../components/CompetitorComparison.astro';
import EditorFaq from '../components/EditorFaq.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="PDF Editor AI — Editor de PDF Online Gratuito e 100% Privado no Navegador"
  description="Edite documentos PDF diretamente no seu navegador com 100% de privacidade em Portugal. Adicione texto, desenhe anotações, assine contratos e oculte dados confidenciais (NIF, IBAN, CC) com IA sem enviar ficheiros para servidores."
>
  <Navbar />
  
  <main>
    <Hero />

    <!-- Interactive In-Browser Studio Section -->
    <section id="demo" class="py-16 bg-white border-b border-[#e3e8ee]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-8">
          <span class="micro-cap text-[#533afd] mb-2 block">Área de Trabalho no Navegador</span>
          <h2 class="display-lg text-[#0d253d] mb-3">
            Experimente o Estúdio PDF Editor AI agora
          </h2>
          <p class="body-md text-[#64748d]">
            Arraste qualquer ficheiro PDF abaixo ou clique em <strong>«Experimentar Contrato de Exemplo»</strong> para testar anotações, assinaturas digitais e a ocultação automática de dados confidenciais por IA em tempo real.
          </p>
        </div>

        <!-- Embedded Editor Studio Island -->
        <PdfEditorStudio mode="embedded" />
      </div>
    </section>

    <EditorFeatures />
    <PrivacyGuarantee />
    <CompetitorComparison />
    <EditorFaq />
  </main>

  <Footer />
</Layout>

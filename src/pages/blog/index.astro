---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { blogPosts, categories, getFeaturedPost } from '../../data/blogPosts';

const featuredPost = getFeaturedPost();
const regularPosts = featuredPost 
  ? blogPosts.filter(p => p.slug !== featuredPost.slug)
  : blogPosts;
const hasPosts = blogPosts.length > 0;

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  'name': 'Blog PDF Editor AI — Guias e Segurança de Documentos',
  'description': 'Artigos práticos, tutoriais e análises técnicas sobre edição de PDF segura, privacidade RGPD em Portugal, ocultação de dados confidenciais e tecnologia WebAssembly no cliente.',
  'url': 'https://pdfeditx.com/blog',
  'publisher': {
    '@type': 'Organization',
    'name': 'PDF Editor AI',
    'logo': {
      '@type': 'ImageObject',
      'url': 'https://pdfeditx.com/og-image.jpg'
    }
  },
  'blogPost': blogPosts.map(post => ({
    '@type': 'BlogPosting',
    'headline': post.title,
    'description': post.description,
    'url': `https://pdfeditx.com/blog/${post.slug}`,
    'datePublished': post.publishDate,
    'author': {
      '@type': 'Person',
      'name': post.author.name
    }
  }))
};
---

<Layout
  title="Blog de Edição de PDF e Privacidade — Guias e Tutoriais | PDF Editor AI"
  description="Tutoriais práticos, boas práticas de segurança, guias RGPD em Portugal e truques para editar, assinar e ocultar dados confidenciais em documentos PDF com 100% de privacidade."
  canonical="https://pdfeditx.com/blog"
  schemaJson={blogSchema}
>
  <Navbar />

  <main class="min-h-screen bg-[var(--bg-page)] text-[var(--text-primary)]">
    <!-- Hero Section with Stripi Gradient Mesh Backdrop -->
    <section class="gradient-mesh-hero border-b border-[#e3e8ee]/70 pt-16 pb-20 px-4 sm:px-6 lg:px-8">
      <div class="max-w-6xl mx-auto text-center space-y-6">
        
        <!-- Breadcrumb & Eyebrow Badge -->
        <div class="flex items-center justify-center gap-2 text-xs font-normal">
          <a href="/" class="text-[#64748d] hover:text-[#533afd] transition-colors">Início</a>
          <span class="text-[#64748d]/50">/</span>
          <span class="text-[#533afd] font-medium">Blog & Artigos</span>
        </div>

        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#533afd]/10 border border-[#533afd]/20 text-[#533afd] text-[11px] font-medium uppercase tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full bg-[#533afd] animate-pulse"></span>
          <span>Centro de Conhecimento e Guias Técnicos</span>
        </div>

        <h1 class="display-xl text-[#0d253d] max-w-4xl mx-auto tracking-tight">
          Guias Práticos, Cibersegurança e Inovações em Documentos PDF
        </h1>

        <p class="body-lg text-[#64748d] max-w-2xl mx-auto font-light">
          Aprenda a editar, assinar eletronicamente e censurar informações confidenciais mantendo a soberania absoluta dos seus dados sem envios para servidores na nuvem.
        </p>

        {hasPosts && (
          <!-- Search Bar -->
          <div class="max-w-xl mx-auto pt-4">
            <div class="relative">
              <input 
                type="text" 
                id="blog-search-input"
                placeholder="Pesquisar tutoriais, NIF, assinatura, RGPD..."
                class="w-full px-5 py-3.5 pl-11 rounded-full bg-white border border-[#a8c3de] text-[#0d253d] placeholder-[#64748d] shadow-sm text-sm focus:outline-none focus:ring-2 focus:ring-[#533afd]/20 focus:border-[#533afd] transition-all"
              />
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-[#64748d] absolute left-4 top-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/>
                <path d="m21 21-4.3-4.3"/>
              </svg>
            </div>
          </div>
        )}

      </div>
    </section>

    <!-- Content Section -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-12">

      {hasPosts ? (
        <>
          <!-- Category Filter Pills -->
          <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none justify-start md:justify-center" id="category-filters">
            {categories.map((cat, idx) => (
              <button
                type="button"
                data-category={cat}
                class={`category-filter-btn px-4 py-2 rounded-full text-xs font-medium cursor-pointer transition-all whitespace-nowrap ${
                  idx === 0 
                    ? 'bg-[#533afd] text-white shadow-xs' 
                    : 'bg-white border border-[#e3e8ee] text-[#273951] hover:border-[#533afd]/50 hover:text-[#533afd]'
                }`}
              >
                {cat}
              </button>
            ))}
          </div>

          <!-- Featured Article Spotlight (Hero Card) -->
          {featuredPost && (
            <div id="featured-article-container" class="blog-card-item" data-category={featuredPost.category} data-title={featuredPost.title.toLowerCase()} data-desc={featuredPost.description.toLowerCase()}>
              <article class="bg-white rounded-3xl border border-[#e3e8ee] shadow-level-2 p-6 sm:p-10 transition-all hover:border-[#533afd]/40 group">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
                  
                  <div class="lg:col-span-7 space-y-4">
                    <div class="flex flex-wrap items-center gap-3">
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-[#b9b9f9]/40 text-[#4434d4] border border-[#533afd]/20 uppercase tracking-wide">
                        {featuredPost.category}
                      </span>
                      <span class="inline-flex items-center gap-1 text-xs text-amber-600 font-medium bg-amber-50 px-2.5 py-0.5 rounded-full border border-amber-200">
                        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                        Artigo em Destaque
                      </span>
                      <span class="text-xs text-[#64748d] flex items-center gap-1">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        {featuredPost.readTime}
                      </span>
                    </div>

                    <h2 class="display-lg text-[#0d253d] group-hover:text-[#533afd] transition-colors leading-snug">
                      <a href={`/blog/${featuredPost.slug}`}>
                        {featuredPost.title}
                      </a>
                    </h2>

                    <p class="body-md text-[#64748d] leading-relaxed">
                      {featuredPost.description}
                    </p>

                    <!-- Author & Read CTA -->
                    <div class="flex items-center justify-between pt-4 border-t border-[#e3e8ee]">
                      <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-full bg-[#1c1e54] text-white flex items-center justify-center text-xs font-semibold">
                          {featuredPost.author.avatar}
                        </div>
                        <div>
                          <p class="text-xs font-medium text-[#0d253d]">{featuredPost.author.name}</p>
                          <p class="text-[11px] text-[#64748d]">{new Date(featuredPost.publishDate).toLocaleDateString('pt-PT', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
                        </div>
                      </div>

                      <a href={`/blog/${featuredPost.slug}`} class="btn-primary-pill text-xs py-2 px-5">
                        <span>Ler Artigo</span>
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                      </a>
                    </div>

                  </div>

                  <!-- Visual Abstract Preview -->
                  <div class="lg:col-span-5 bg-[#f6f9fc] rounded-2xl p-6 border border-[#e3e8ee] space-y-4">
                    <div class="flex items-center justify-between text-xs text-[#64748d] pb-2 border-b border-[#e3e8ee]">
                      <span class="font-medium text-[#0d253d] uppercase tracking-wider text-[11px]">Resumo Executivo</span>
                      <span class="text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded text-[10px] font-medium border border-emerald-200">100% Verificado</span>
                    </div>
                    <ul class="space-y-2.5 text-xs text-[#273951]">
                      {featuredPost.keyTakeaways?.slice(0, 3).map(takeaway => (
                        <li class="flex items-start gap-2">
                          <svg class="w-4 h-4 text-[#533afd] shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>
                          <span>{takeaway}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                </div>
              </article>
            </div>
          )}

          <!-- Article Grid Header -->
          {regularPosts.length > 0 && (
            <div class="flex items-center justify-between border-b border-[#e3e8ee] pb-4">
              <div>
                <h2 class="heading-md text-[#0d253d] font-normal">Todos os Artigos</h2>
                <p class="text-xs text-[#64748d]">Explore publicações detalhadas sobre produtividade e conformidade de documentos</p>
              </div>
              <span id="post-counter" class="text-xs text-[#64748d] bg-[#f6f9fc] px-3 py-1 rounded-full border border-[#e3e8ee]">
                {blogPosts.length} artigos disponíveis
              </span>
            </div>
          )}

          <!-- Articles Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="posts-grid">
            {regularPosts.map((post) => (
              <article 
                class="blog-card-item bg-white rounded-2xl border border-[#e3e8ee] shadow-level-1 hover:shadow-level-2 transition-all p-6 flex flex-col justify-between group hover:border-[#533afd]/50"
                data-category={post.category}
                data-title={post.title.toLowerCase()}
                data-desc={post.description.toLowerCase()}
              >
                <div class="space-y-4">
                  <!-- Meta Tags -->
                  <div class="flex items-center justify-between text-xs">
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium bg-[#f6f9fc] text-[#4434d4] border border-[#e3e8ee]">
                      {post.category}
                    </span>
                    <span class="text-[#64748d] text-[11px] flex items-center gap-1">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                      {post.readTime}
                    </span>
                  </div>

                  <!-- Title -->
                  <h3 class="heading-sm text-[#0d253d] group-hover:text-[#533afd] transition-colors line-clamp-2 leading-snug">
                    <a href={`/blog/${post.slug}`}>
                      {post.title}
                    </a>
                  </h3>

                  <!-- Excerpt -->
                  <p class="text-xs text-[#64748d] line-clamp-3 leading-relaxed">
                    {post.description}
                  </p>
                </div>

                <!-- Footer Author & Date -->
                <div class="pt-5 mt-5 border-t border-[#e3e8ee] flex items-center justify-between text-xs">
                  <div class="flex items-center gap-2">
                    <div class="w-6 h-6 rounded-full bg-[#1c1e54] text-white flex items-center justify-center text-[10px] font-semibold">
                      {post.author.avatar}
                    </div>
                    <span class="text-[11px] text-[#64748d]">{post.author.name}</span>
                  </div>

                  <a href={`/blog/${post.slug}`} class="text-[12px] font-medium text-[#533afd] flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                    <span>Ler</span>
                    <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </a>
                </div>
              </article>
            ))}
          </div>

          <!-- No Results Message -->
          <div id="no-results-view" class="hidden text-center py-16 bg-[#f6f9fc] rounded-2xl border border-dashed border-[#e3e8ee] space-y-3">
            <svg class="w-10 h-10 text-[#64748d] mx-auto opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <circle cx="11" cy="11" r="8"/>
              <path d="m21 21-4.3-4.3"/>
            </svg>
            <p class="text-sm font-medium text-[#0d253d]">Nenhum artigo encontrado</p>
            <p class="text-xs text-[#64748d]">Experimente outro termo de pesquisa ou limpe os filtros de categoria.</p>
            <button id="reset-filters-btn" class="btn-secondary-pill text-xs py-1.5 px-4 mt-2">
              Limpar Filtros
            </button>
          </div>
        </>
      ) : (
        <!-- Elegant Empty State when user hasn't added articles yet -->
        <div class="text-center py-20 px-6 bg-white rounded-3xl border border-[#e3e8ee] shadow-level-1 max-w-2xl mx-auto space-y-5">
          <div class="w-16 h-16 rounded-2xl bg-[#533afd]/10 text-[#533afd] flex items-center justify-center mx-auto">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
            </svg>
          </div>
          <div class="space-y-2">
            <h2 class="heading-lg text-[#0d253d]">Novos Artigos em Preparação</h2>
            <p class="body-md text-[#64748d] max-w-md mx-auto">
              Esta secção de blog está pronta. Em breve publicaremos novos guias sobre edição segura de PDF, conformidade RGPD e inteligência artificial no cliente.
            </p>
          </div>
          <div class="pt-3 flex flex-wrap items-center justify-center gap-3">
            <a href="/edit" class="btn-primary-pill text-xs py-2 px-5">
              <span>Abrir Editor no Navegador</span>
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="/privacy" class="btn-secondary-pill text-xs py-2 px-5">
              <span>Ver Política de Privacidade</span>
            </a>
          </div>
        </div>
      )}

      <!-- Warm Interlude / Educational Banner (DESIGN.md card-cream-band) -->
      <section class="bg-[#f5e9d4] rounded-3xl p-8 sm:p-10 border border-[#e8d5b8] text-[#0d253d] shadow-level-1">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
          <div class="md:col-span-8 space-y-3">
            <span class="micro-cap text-[#9b6829] block">Garantia Técnica de Soberania</span>
            <h3 class="heading-lg text-[#0d253d] font-normal">
              Precisa de testar a privacidade do seu próprio navegador?
            </h3>
            <p class="body-md text-[#273951] leading-relaxed">
              Experimente o <strong>Teste do Modo de Voo</strong>: abra a ferramenta, desligue o Wi-Fi e edite qualquer documento. Comprovamos em tempo real que zero dados saem da sua máquina.
            </p>
          </div>
          <div class="md:col-span-4 flex flex-col sm:flex-row md:flex-col gap-3 justify-center">
            <a href="/edit" class="btn-primary-pill text-xs py-2.5 px-6 text-center">
              Abrir Estúdio sem Custos
            </a>
            <a href="/privacy" class="btn-secondary-pill text-xs py-2.5 px-6 text-center">
              Auditoria de Segurança
            </a>
          </div>
        </div>
      </section>

    </section>
  </main>

  <Footer />
</Layout>

<script>
  function setupBlogFiltering() {
    const searchInput = document.getElementById('blog-search-input') as HTMLInputElement | null;
    const filterButtons = document.querySelectorAll('.category-filter-btn');
    const articles = document.querySelectorAll('.blog-card-item');
    const counterSpan = document.getElementById('post-counter');
    const noResultsView = document.getElementById('no-results-view');
    const resetBtn = document.getElementById('reset-filters-btn');

    if (articles.length === 0) return;

    let currentCategory = 'Todos';
    let currentSearchTerm = '';

    function applyFilters() {
      let visibleCount = 0;

      articles.forEach((item) => {
        const el = item as HTMLElement;
        const itemCategory = el.getAttribute('data-category') || '';
        const itemTitle = el.getAttribute('data-title') || '';
        const itemDesc = el.getAttribute('data-desc') || '';

        const matchesCategory = currentCategory === 'Todos' || itemCategory === currentCategory;
        const matchesSearch = !currentSearchTerm || 
          itemTitle.includes(currentSearchTerm) || 
          itemDesc.includes(currentSearchTerm);

        if (matchesCategory && matchesSearch) {
          el.classList.remove('hidden');
          visibleCount++;
        } else {
          el.classList.add('hidden');
        }
      });

      if (counterSpan) {
        counterSpan.textContent = `${visibleCount} ${visibleCount === 1 ? 'artigo encontrado' : 'artigos disponíveis'}`;
      }

      if (noResultsView) {
        if (visibleCount === 0) {
          noResultsView.classList.remove('hidden');
        } else {
          noResultsView.classList.add('hidden');
        }
      }
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach((b) => {
          b.classList.remove('bg-[#533afd]', 'text-white', 'shadow-xs');
          b.classList.add('bg-white', 'border', 'border-[#e3e8ee]', 'text-[#273951]');
        });
        btn.classList.add('bg-[#533afd]', 'text-white', 'shadow-xs');
        btn.classList.remove('bg-white', 'text-[#273951]');

        currentCategory = btn.getAttribute('data-category') || 'Todos';
        applyFilters();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        currentSearchTerm = (e.target as HTMLInputElement).value.toLowerCase().trim();
        applyFilters();
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        currentSearchTerm = '';
        currentCategory = 'Todos';
        filterButtons.forEach((b, i) => {
          if (i === 0) {
            b.classList.add('bg-[#533afd]', 'text-white', 'shadow-xs');
            b.classList.remove('bg-white', 'text-[#273951]');
          } else {
            b.classList.remove('bg-[#533afd]', 'text-white', 'shadow-xs');
            b.classList.add('bg-white', 'border', 'border-[#e3e8ee]', 'text-[#273951]');
          }
        });
        applyFilters();
      });
    }
  }

  setupBlogFiltering();
  document.addEventListener('astro:page-load', setupBlogFiltering);
</script>

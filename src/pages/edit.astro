---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import PdfEditorStudio from '../components/PdfEditorStudio.astro';
---

<Layout 
  title="Editar PDF Online Grátis — Estúdio Editor de PDF no Navegador | PDF Editor AI"
  description="Edite PDF online gratuitamente no seu navegador sem instalar nada. Adicione texto, assine contratos, desenhe anotações e mascare dados confidenciais com 100% de privacidade."
  canonical="https://pdfeditx.com/edit"
>
  <div class="h-screen flex flex-col overflow-hidden bg-white">
    <Navbar isEditorPage={true} />
    <main class="flex-1 flex flex-col overflow-hidden">
      <PdfEditorStudio mode="standalone" />
    </main>
  </div>
</Layout>

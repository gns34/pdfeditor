---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import PdfEditorStudio from '../components/PdfEditorStudio.astro';
---

<Layout 
  title="Estúdio PDF — PDF Editor AI | Editor Local Gratuito no Navegador"
  description="Editor de PDF em ecrã inteiro no navegador com 100% de privacidade em Portugal. Edite texto, desenhe livremente, destaque, insira formas, assine digitalmente e oculte dados confidenciais."
>
  <div class="h-screen flex flex-col overflow-hidden bg-white">
    <Navbar isEditorPage={true} />
    <main class="flex-1 flex flex-col overflow-hidden">
      <PdfEditorStudio mode="standalone" />
    </main>
  </div>
</Layout>
